---
import { menu } from '../data/seo';
import { whatsappLinki } from '../data/isletme';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props { tema?: 'koyu' | 'acik' }
const { tema = 'acik' } = Astro.props;
const logo = tema === 'koyu' ? '/img/logo-light.svg' : '/img/logo.svg';
const yol = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class:list={['nav', { 'nav--light': tema === 'acik' }]}>
  <a class="nav__logo" href="/" aria-label="Profit EMS ana sayfa"><img src={logo} alt="Profit EMS" width="128" height="54" fetchpriority="high"></a>
  <nav aria-label="Ana menü">
    <ul class="nav__links">
      {menu.map(m => <li><a href={m.href} aria-current={m.href === yol || yol.startsWith(m.href + '/') ? 'page' : undefined}>{m.etiket}</a></li>)}
    </ul>
  </nav>
  <div class="nav__action">
    <a class="btn" href={whatsappLinki()} target="_blank" rel="noopener">
      <WhatsAppIcon />
      <span class="nav__wa-text">WhatsApp'tan yaz</span>
    </a>
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="mobil-menu">Menü</button>
  </div>
</header>

<div class="mmenu" id="mobil-menu" hidden>
  <nav aria-label="Mobil menü">
    <ul>
      {menu.map(m => <li><a href={m.href}>{m.etiket}</a></li>)}
    </ul>
  </nav>
  <a class="btn" href={whatsappLinki()} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp'tan yaz</a>
</div>

<script is:inline>
(() => {
  const btn = document.querySelector('.nav__menu');
  const panel = document.getElementById('mobil-menu');
  const set = open => {
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Kapat' : 'Menü';
    document.documentElement.classList.toggle('menu-acik', open);
  };
  btn.addEventListener('click', () => set(panel.hidden));
  panel.querySelectorAll('a').forEach(a => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) set(false); });
})();
</script>
