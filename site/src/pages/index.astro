---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import BolgeFigur from '../components/BolgeFigur.astro';
import { isletme, whatsappLinki, tamAdres, yolTarifiLinki } from '../data/isletme';
import { hizmetler } from '../data/hizmetler';
import { ekip } from '../data/ekip';
import { yazilar, tarihYaz } from '../data/blog';
import '../styles/home.css';
const { whatsapp } = isletme;
const { acilis, kapanis } = isletme.saatler;
const tumYazilar = await yazilar();
const [sonYazi, ...digerYazilar] = tumYazilar.slice(0, 5);
const kisaAd = (h: (typeof hizmetler)[number]) => (h as { kisaAd?: string }).kisaAd ?? h.ad;
// the hero's current line: flat, then bursts of biphasic square pulses (the shape an EMS device sends)
const dalga = (() => {
  let d = 'M0 40', x = 0;
  for (const n of [3, 3, 3, 3]) {
    x += 46; d += ` H${x}`;
    for (let i = 0; i < n; i++) { d += ` V10 H${x + 9} V70 H${x + 18} V40`; x += 18; if (i < n - 1) { x += 8; d += ` H${x}`; } }
    x += 46; d += ` H${x}`;
  }
  return { d, w: x };
})();
const serit = [...hizmetler.map(kisaAd), `Her gün ${acilis}–${kapanis}`, `${isletme.adres.ilce} / ${isletme.adres.il}`];
---
<Base yol="/">

<div class="stage">
<video class="stage__video" muted loop playsinline preload="none" poster="/video/hero-yatay.jpg" aria-hidden="true"
  data-src-wide="/video/hero-yatay.mp4" data-src-narrow="/video/hero-dikey.mp4"
  data-poster-wide="/video/hero-yatay.jpg" data-poster-narrow="/video/hero-dikey.jpg"></video>

<Nav tema="koyu" />

<main>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__main">
      <h1 class="hero__title" id="hero-title">
        <span class="line"><span>Akım</span></span>{" "}
        <span class="line"><span>senden</span></span>{" "}
        <span class="line line--hot"><span>yana<i>.</i></span></span>
      </h1>
      <svg class="pulse" viewBox={`0 0 ${dalga.w} 80`} preserveAspectRatio="none" aria-hidden="true">
        <path class="pulse__base" d={dalga.d} pathLength="100" />
        <path class="pulse__spark" d={dalga.d} pathLength="100" />
      </svg>
    </div>
  </section>
</main>
<!-- the goals and the hours on a slanted running band, in the logo's angle -->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[0, 1].map(() => <span class="ticker__set">{serit.map(t => <span class="ticker__item">{t}</span>)}</span>)}
  </div>
</div>
</div>

<section class="story" id="ems-nedir" aria-labelledby="story-title">
  <div class="story__pin">
    <div class="story__text">
      <h2 class="story__title" id="story-title">EMS nasıl çalışır?</h2>
      <div class="story__bar" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <ol class="story__steps">
        <li class="story__step is-active">
          <p class="story__big">Önce kıyafet.</p>
          <p>Elektrotları taşıyan özel EMS kıyafetini giyersin.</p>
        </li>
        <li class="story__step">
          <p class="story__big">Elektrotlar yerine oturur.</p>
          <p>Göğüs, karın, kol, bel ve bacaklardaki pedler büyük kas gruplarının üstüne gelir.</p>
        </li>
        <li class="story__step">
          <p class="story__big">Uyarı kaslara ulaşır.</p>
          <p>Cihaz, pedler üzerinden kaslara hafif elektrik uyarıları gönderir ve kaslar kasılır.</p>
        </li>
        <li class="story__step">
          <p class="story__big">Sırt ve bel de çalışır.</p>
          <p>Arkadaki pedler sırt, bel ve kalça kaslarını da devreye sokar.</p>
        </li>
        <li class="story__step">
          <p class="story__big">Sen hareket ettikçe.</p>
          <p>Squat gibi basit hareketler sırasında kaslar uyarıyla birlikte çalışır.</p>
        </li>
        <li class="story__step">
          <p class="story__big">Sıra sende.</p>
          <p>Hedefini seç, figürde çalışan bölgeleri gör ve bize yaz.</p>
          <fieldset class="goals">
            <legend class="sr-only">Hedefin hangisi?</legend>
            <div class="goals__list">
              <button type="button" class="goal" data-goal="zayiflama" data-label="Zayıflama" aria-pressed="false">Zayıflama</button>
              <button type="button" class="goal" data-goal="sikilasma" data-label="Sıkılaşma" aria-pressed="false">Sıkılaşma</button>
              <button type="button" class="goal" data-goal="incelme" data-label="İncelme" aria-pressed="false">İncelme</button>
              <button type="button" class="goal" data-goal="agri" data-label="Bel ve boyun ağrısı" aria-pressed="false">Bel ve boyun</button>
            </div>
          </fieldset>
          <p class="goals__note" id="goal-note" aria-live="polite"></p>
          <a class="btn" id="story-wa" href={whatsappLinki('Merhaba, EMS hakkında bilgi almak istiyorum.')} target="_blank" rel="noopener">WhatsApp'tan yaz</a>
        </li>
      </ol>
      <div class="story__nav" hidden>
        <button type="button" class="story__arrow" data-dir="-1" aria-label="Önceki adım"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
        <p class="story__count" aria-live="polite"><b>1</b> / 6</p>
        <button type="button" class="story__arrow" data-dir="1" aria-label="Sonraki adım"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
        <span class="story__hint" aria-hidden="true">Sağa sola kaydır</span>
      </div>
    </div>

    <figure class="story__figure" aria-hidden="true">
      <div class="story__3d" id="ems-3d"></div>
      <svg id="rig" viewBox="-20 20 440 580">
        <defs><clipPath id="suit-clip"><rect id="suit-clip-rect" x="90" y="100" width="220" height="260" /></clipPath></defs>
        <polygon class="fig-band" points="20,640 200,640 400,120 220,120" />
        <g id="turn">
          <path id="thighL" class="fig-limb" stroke-width="48" />
          <path id="calfL" class="fig-limb" stroke-width="38" />
          <path id="footL" class="fig-limb" stroke-width="20" />
          <path id="thighR" class="fig-limb" stroke-width="48" />
          <path id="calfR" class="fig-limb" stroke-width="38" />
          <path id="footR" class="fig-limb" stroke-width="20" />
          <path id="uarmL" class="fig-limb" stroke-width="36" />
          <path id="farmL" class="fig-limb" stroke-width="30" />
          <path id="uarmR" class="fig-limb" stroke-width="36" />
          <path id="farmR" class="fig-limb" stroke-width="30" />
          <circle id="bicepL" class="fig-body" r="21" />
          <circle id="bicepR" class="fig-body" r="21" />
          <circle id="handL" class="fig-body" />
          <circle id="handR" class="fig-body" />
          <g id="upper">
            <rect class="fig-body" x="186" y="92" width="28" height="32" />
            <circle class="fig-body" cx="200" cy="66" r="34" />
            <path class="fig-body" d="M138 132 Q200 112 262 132 L248 300 Q200 312 152 300 Z" />
            <g clip-path="url(#suit-clip)">
              <path class="fig-suit" d="M146 134 Q200 118 254 134 L244 296 Q200 306 156 296 Z" />
              <path class="fig-suit" d="M152 292 Q200 304 248 292 L256 344 L214 352 L200 336 L186 352 L144 344 Z" />
              <path id="zip" class="zip" d="M200 128 L200 296" />
              <rect x="186" y="286" width="28" height="18" fill="#2a2d33" />
            </g>
          </g>
          <path id="strapArmL" class="fig-strap" stroke-width="10" />
          <path id="strapArmR" class="fig-strap" stroke-width="10" />
          <path id="strapLegL" class="fig-strap" stroke-width="12" />
          <path id="strapLegR" class="fig-strap" stroke-width="12" />
          <g id="wires"></g>
          <g id="pads-front"></g>
          <g id="pads-back"></g>
        </g>
      </svg>
    </figure>
    <!-- decided before the first paint: where 3D will be drawn, the 2D figure never shows (it is only the fallback) -->
    <script is:inline>if ('WebGL2RenderingContext' in window) document.currentScript.previousElementSibling.classList.add('is-3d-wait');</script>
  </div>
</section>

<!-- the rest of the home page: one claim per section, each leading to its own page -->
<div class="hs">
  <!-- 1 · the four goals as words at poster size; pointing at one opens its photograph on the slant -->
  <section class="hg" aria-labelledby="hg-baslik">
    <div class="hg__head">
      <h2 class="hs-h2" id="hg-baslik" data-rise>Dört hedef, tek kıyafet</h2>
      <p data-rise>Her hedefte kıyafetteki farklı pedler çalışır. Hangisi sana uygun, hizmetlerde ayrıntısıyla anlattık.</p>
    </div>
    <div class="hg__body">
    <ul class="hg__list">
      {hizmetler.map((h, i) => (
        <li data-rise>
          <a class="hg__row" href={`/hizmetler#${h.id}`} data-i={i}>
            <span class="hg__name">{kisaAd(h)}</span>
            <span class="hg__zones">{h.bolgeler}</span>
          </a>
        </li>
      ))}
    </ul>
    <figure class="hg__peek" aria-hidden="true">
      {hizmetler.map((h, i) => <img class:list={[{ 'is-on': i === 0 }]} src={h.gorsel} srcset={h.srcset} sizes="34vw" alt="" width={h.boyut[0]} height={h.boyut[1]} loading="lazy" decoding="async" style={`object-position:${h.odak}`}>)}
    </figure>
    </div>
    <!-- on a phone the four goals are tall slanted cards on a rail: swipe sideways, each settles in the centre;
         the small figure shows which pads that goal works -->
    <div class="hg-m">
      <ul class="rail">
        {hizmetler.map((h, i) => (
          <li class:list={['rail__c', { 'is-on': i === 0 }]}>
            <a class="rail__a" href={`/hizmetler#${h.id}`}>
              <img src={h.gorsel} srcset={h.srcset} sizes="78vw" alt="" width={h.boyut[0]} height={h.boyut[1]} loading="lazy" decoding="async" style={`object-position:${h.odak}`}>
              <span class="rail__fig" aria-hidden="true"><BolgeFigur zones={h.bolge} /></span>
              <span class="rail__ad">{kisaAd(h)}</span>
              <span class="rail__alt">{h.bolgeler}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2 · the coaches, an echo of the Ekibimiz panels -->
  <section class="ht" aria-labelledby="ht-baslik">
    <div class="ht__text">
      <h2 class="hs-h2" id="ht-baslik" data-rise>Seansını hocan yönetir</h2>
      <p data-rise>{isletme.adres.ilce}'daki stüdyomuzda seanslarını üç hoca yönetir. Onları tanı, hangisiyle çalışacağını seç.</p>
      <a class="btn btn--light" href="/ekibimiz" data-rise>Ekibimizi tanı</a>
    </div>
    <div class="ht__serit" data-serit>
      <ul class="serit">
        {ekip.map((h, i) => (
          <li class:list={['serit__p', { 'is-on': i === 0 }]}>
            <img src={`/img/ekip/${h.id}-1200.webp`} alt="" width="1200" height="1600" loading="lazy" decoding="async" style={`object-position:${h.odak}`}>
            <span class="serit__kisa" aria-hidden="true">{h.ad ? h.ad.split(' ')[0] : 'Yakında'}</span>
            <button class="serit__sec" type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{h.ad || 'Yakında'}</button>
          </li>
        ))}
      </ul>
      <div class="serit__detay" aria-live="polite">
        {ekip.map((h, i) => (
          <div class:list={[{ 'is-on': i === 0 }]}>
            <p class="serit__ad">{h.ad || 'Yakında'}</p>
            {h.unvan && <p class="serit__alt">{h.unvan}</p>}
            {h.tanitim && <p>{h.tanitim}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · the newest post at full weight, the next two as plain lines -->
  {sonYazi && (
    <section class="hp" aria-labelledby="hp-baslik">
      <div class="hp__head">
        <h2 class="hs-h2" id="hp-baslik" data-rise>EMS üzerine yazılar</h2>
        <a class="hp__all" href="/blog" data-rise>Tüm yazılar ({tumYazilar.length})</a>
      </div>
      <div class="hp__grid">
        <a class="hp__feat" href={`/blog/${sonYazi.id}`} data-rise>
          <span class="hp__img"><img src={sonYazi.data.kapak} alt={sonYazi.data.kapakAlt} width="2000" height="1500" loading="lazy" decoding="async"></span>
          <span class="hp__date">{tarihYaz(sonYazi.data.tarih)}</span>
          <span class="hp__title">{sonYazi.data.baslik}</span>
          <span class="hp__desc">{sonYazi.data.aciklama}</span>
        </a>
        <ul class="hp__more">
          {digerYazilar.map(y => (
            <li data-rise>
              <a href={`/blog/${y.id}`}>
                <span class="hp__thumb"><img src={y.data.kapak} alt="" width="2000" height="1500" loading="lazy" decoding="async"></span>
                <span class="hp__row">
                  <span class="hp__date">{tarihYaz(y.data.tarih)}</span>
                  <span class="hp__title hp__title--s">{y.data.baslik}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 4 · where we are and whether we are open right now -->
  <section class="hv" aria-labelledby="hv-baslik">
    <h2 class="hs-h2 hv__title" id="hv-baslik" data-rise>{isletme.adres.ilce}'dayız</h2>
    <div class="hv__grid">
      <div data-rise>
        <p class="hv__label">Adres</p>
        <p class="hv__big"><a href={yolTarifiLinki} target="_blank" rel="noopener">{isletme.adres.bina}</a></p>
        <p>{tamAdres}. {isletme.adres.tarif}.</p>
      </div>
      <div data-rise>
        <p class="hv__label">Saatler</p>
        <p class="hv__big">{isletme.saatler.metin}</p>
        <p id="hv-durum" aria-live="polite">Her gün açığız.</p>
      </div>
      <div class="hv__actions" data-rise>
        <a class="btn btn--light" href={whatsappLinki('Merhaba, randevu almak istiyorum.')} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp'tan yaz</a>
        <a class="btn btn--ghost" href={yolTarifiLinki} target="_blank" rel="noopener">Yol tarifi al</a>
        <a class="btn btn--ghost" href={`tel:${isletme.telefonUluslararasi}`}>Ara: {isletme.telefon}</a>
      </div>
    </div>
  </section>
</div>


<script is:inline define:vars={{ whatsapp, acilis, kapanis }}>
// open right now? (Konya time) for the visit band
(() => {
  const el = document.getElementById('hv-durum');
  if (!el) return;
  const now = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Istanbul', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
  const toMin = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
  const n = toMin(now), o = toMin(acilis), c = toMin(kapanis);
  if (n >= o && n < c) {
    const left = c - n, h = Math.floor(left / 60), m = left % 60;
    el.textContent = `Şu an açığız. Kapanışa ${[h && `${h} saat`, m && `${m} dakika`].filter(Boolean).join(' ')} var.`;
  } else el.textContent = n < o ? `Şu an kapalıyız. Bugün ${acilis}'da açılıyoruz.` : `Şu an kapalıyız. Yarın ${acilis}'da açılıyoruz.`;
})();

// slanted strips (goals on a phone, coaches everywhere): tap, swipe or point to choose
document.querySelectorAll('[data-serit]').forEach(grup => {
  const ps = [...grup.querySelectorAll('.serit__p')];
  const ds = [...grup.querySelectorAll('.serit__detay > *')];
  let cur = 0;
  const choose = i => {
    if (i === cur) return;
    cur = i;
    ps.forEach((p, j) => { p.classList.toggle('is-on', j === i); p.querySelector('.serit__sec').setAttribute('aria-pressed', String(j === i)); });
    ds.forEach((d, j) => d.classList.toggle('is-on', j === i));
  };
  ps.forEach((p, i) => {
    p.querySelector('.serit__sec').addEventListener('click', () => choose(i));
    p.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') choose(i); });
  });
  const ul = grup.querySelector('.serit');
  let x0 = null, y0 = null;
  ul.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  ul.addEventListener('touchend', e => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    x0 = null;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
    choose(Math.max(0, Math.min(ps.length - 1, cur + (dx < 0 ? 1 : -1))));
  }, { passive: true });
});

// goals rail (phone): the card resting in the centre is the lit one
(() => {
  const rail = document.querySelector('.rail');
  if (!rail || !('IntersectionObserver' in window)) return;
  const cards = [...rail.children];
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) cards.forEach(c => c.classList.toggle('is-on', c === e.target));
  }), { root: rail, threshold: 0.7 });
  cards.forEach(c => io.observe(c));
})();

// goals list: the photograph beside the list follows the row being pointed at
(() => {
  const peek = document.querySelector('.hg__peek');
  if (!peek) return;
  const imgs = [...peek.querySelectorAll('img')];
  const list = document.querySelector('.hg__list');
  document.querySelectorAll('.hg__row').forEach(row => {
    const show = () => {
      imgs.forEach((im, i) => im.classList.toggle('is-on', i === Number(row.dataset.i)));
      // centred on the row, but never above the list or below it (it would cover the words around it)
      const r = row.getBoundingClientRect(), l = list.getBoundingClientRect(), h = peek.offsetHeight;
      const y = Math.min(Math.max(r.top - l.top + r.height / 2, h / 2), Math.max(h / 2, l.height - h / 2));
      peek.style.setProperty('--y', `${y}px`);
      peek.classList.add('is-open');
    };
    row.addEventListener('pointerenter', show);
    row.addEventListener('focus', show);
  });
  list.addEventListener('pointerleave', () => peek.classList.remove('is-open'));
  list.addEventListener('focusout', e => { if (!list.contains(e.relatedTarget)) peek.classList.remove('is-open'); });
})();

// background clip: phones get the light portrait cut; skipped for reduced motion / data saver
(() => {
  const v = document.querySelector('.stage__video');
  const narrow = matchMedia('(max-width: 860px)').matches;
  v.poster = narrow ? v.dataset.posterNarrow : v.dataset.posterWide;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saver = navigator.connection && navigator.connection.saveData;
  if (reduce || saver) return;
  v.src = narrow ? v.dataset.srcNarrow : v.dataset.srcWide;
  v.play().catch(() => {});
})();

// entrance runs through Motion (module below); CSS fallback if it fails to load
setTimeout(() => { if (!window.__motion) document.body.classList.add('is-in'); }, 1200);

// goal picker (last step of the EMS story): lights that goal's pads and fills the WhatsApp message
const rigEl = document.getElementById('rig');
const note = document.getElementById('goal-note');
const storyWa = document.getElementById('story-wa');
const waBase = `https://wa.me/${whatsapp}?text=`;
const notes = {
  zayiflama: 'Zayıflama: karın ve bacak bölgeleri birlikte çalışır.',
  sikilasma: 'Sıkılaşma: göğüs, kol ve bacak kasları çalışır.',
  incelme: 'İncelme: karın ve bel çevresi öne çıkar.',
  agri: 'Bel ve boyun: omuz ve bel bölgesi desteklenir.'
};
document.querySelectorAll('.goal').forEach(btn => {
  btn.addEventListener('click', () => {
    const goal = btn.dataset.goal;
    const was = btn.getAttribute('aria-pressed') === 'true';
    const pads = rigEl.querySelectorAll('#pads-front .pad');
    document.querySelectorAll('.goal').forEach(b => b.setAttribute('aria-pressed', 'false'));
    if (was) {
      rigEl.classList.remove('figure--focus');
      note.textContent = '';
      storyWa.href = waBase + encodeURIComponent('Merhaba, EMS hakkında bilgi almak istiyorum.');
      document.dispatchEvent(new CustomEvent('goal:change', { detail: null }));
      return;
    }
    btn.setAttribute('aria-pressed', 'true');
    rigEl.classList.add('figure--focus');
    pads.forEach(p => p.classList.toggle('is-on', (p.dataset.zones || '').split(' ').includes(goal)));
    note.textContent = notes[goal];
    storyWa.href = waBase + encodeURIComponent(`Merhaba, ${btn.dataset.label} hedefim için bilgi almak istiyorum.`);
    document.dispatchEvent(new CustomEvent('goal:change', { detail: goal }));
  });
});
</script>
<script>
import { animate, stagger, press, inView } from 'motion';

window.__motion = true;
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const ease = [0.22, 1, 0.36, 1];
const tap = { type: 'spring', stiffness: 400, damping: 20 };

// the first screen animates in plain CSS (home.css); with reduced motion the rest simply shows
if (reduce) document.body.classList.add('is-in');

// the sections after the story: heading, then text, then the rest, once each comes into view
if (!reduce) {
  document.querySelectorAll('.hs > section').forEach(block => {
    inView(block, () => {
      animate(block.querySelectorAll('[data-rise]'), { opacity: [0, 1], y: [24, 0] }, { duration: 0.7, ease, delay: stagger(0.07, { startDelay: 0.05 }) });
    }, { amount: 0.15 });
  });
} else document.querySelectorAll('.hs [data-rise]').forEach(el => { el.style.opacity = '1'; el.style.transform = 'none'; });

// choosing a goal sends an impulse through the figure
document.addEventListener('goal:change', () => {
  if (reduce) return;
  animate('#rig', { x: [0, -3, 3, -2, 1, 0] }, { duration: 0.35 });
  animate('#pads-front .pad.is-on .pad__body', { scale: [1, 1.22, 1] }, { duration: 0.45, ease, delay: stagger(0.03) });
});
</script>
<script>
// EMS story: the figure is rebuilt from joint positions on every animation frame

const section = document.getElementById('ems-nedir');
const reduceStory = matchMedia('(prefers-reduced-motion: reduce)').matches;
const svgNS = 'http://www.w3.org/2000/svg';
const $ = id => document.getElementById(id);
const rig = $('rig');

const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
const lerp = (a, b, t) => a + (b - a) * t;
const ease = t => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
const seg = (p, a, b) => clamp((p - a) / (b - a));
const mix = (A, B, t) => [lerp(A[0], B[0], t), lerp(A[1], B[1], t)];
const along = (A, B, t) => mix(A, B, t);
const angle = (A, B) => Math.atan2(B[1] - A[1], B[0] - A[0]) * 180 / Math.PI;
const line = (A, B) => `M${A[0].toFixed(1)} ${A[1].toFixed(1)} L${B[0].toFixed(1)} ${B[1].toFixed(1)}`;
const mirror = P => [400 - P[0], P[1]];
const perp = (A, B, t, len) => {
  const C = along(A, B, t), dx = B[0] - A[0], dy = B[1] - A[1], l = Math.hypot(dx, dy) || 1;
  const nx = -dy / l * len / 2, ny = dx / l * len / 2;
  return line([C[0] - nx, C[1] - ny], [C[0] + nx, C[1] + ny]);
};

// pads: [zone, anchor] where anchor is a fixed torso point or a spot along a limb
const FRONT = [
  { z: 'agri', at: [170, 146], w: 24, h: 12 }, { z: 'agri', at: [230, 146], w: 24, h: 12 },
  { z: 'sikilasma', at: [178, 171], w: 32, h: 22 }, { z: 'sikilasma', at: [222, 171], w: 32, h: 22 },
  { z: 'zayiflama incelme', at: [183, 213], w: 26, h: 30 }, { z: 'zayiflama incelme', at: [217, 213], w: 26, h: 30 },
  { z: 'incelme agri', at: [171, 260], w: 22, h: 32 }, { z: 'incelme agri', at: [229, 260], w: 22, h: 32 },
  { z: 'sikilasma', limb: 'uarmL', t: .45, w: 28, h: 18 }, { z: 'sikilasma', limb: 'uarmR', t: .45, w: 28, h: 18 },
  { z: 'zayiflama sikilasma', limb: 'thighL', t: .42, w: 36, h: 24 }, { z: 'zayiflama sikilasma', limb: 'thighR', t: .42, w: 36, h: 24 },
];
const BACK = [
  { at: [172, 172], w: 30, h: 24 }, { at: [228, 172], w: 30, h: 24 },
  { at: [176, 222], w: 26, h: 28 }, { at: [224, 222], w: 26, h: 28 },
  { at: [180, 268], w: 28, h: 22 }, { at: [220, 268], w: 28, h: 22 },
  { at: [180, 320], w: 30, h: 24 }, { at: [220, 320], w: 30, h: 24 },
  { limb: 'uarmL', t: .5, w: 26, h: 16 }, { limb: 'uarmR', t: .5, w: 26, h: 16 },
  { limb: 'thighL', t: .5, w: 34, h: 22 }, { limb: 'thighR', t: .5, w: 34, h: 22 },
];

function makePads(list, parent) {
  return list.map((def, i) => {
    const g = document.createElementNS(svgNS, 'g');
    g.setAttribute('class', 'pad');
    if (def.z) g.dataset.zones = def.z;
    g.style.setProperty('--d', `${(i % 6) * 0.18}s`);
    const r = `x="${-def.w / 2}" y="${-def.h / 2}" width="${def.w}" height="${def.h}" rx="4"`;
    g.innerHTML = `<rect class="ring" ${r}/><rect class="pad__body" ${r}/><circle class="pad__snap" r="2.6"/>`;
    parent.appendChild(g);
    return { def, g };
  });
}
const padsFront = makePads(FRONT, $('pads-front'));
const padsBack = makePads(BACK, $('pads-back'));
const wires = [0, 1, 2, 3].map(() => {
  const p = document.createElementNS(svgNS, 'path');
  p.setAttribute('class', 'fig-wire');
  $('wires').appendChild(p);
  return p;
});

function pose(p) {
  const s = (1 - Math.cos(seg(p, .78, .93) * Math.PI * 4)) / 2;     // two squats
  const a = ease(seg(p, .93, .99));                                   // final flex
  const dy = 44 * s;
  const J = {};
  J.shL = [150, 140 + dy];
  J.elL = mix([136, 222 + dy], [84, 150 + dy], a);
  J.haL = mix([132, 296 + dy], [92, 84 + dy], a);
  J.hiL = [178, 330 + dy];
  J.knL = [lerp(174, 122, s), lerp(440, 448, s)];
  J.anL = [166, 548];
  for (const k of ['sh', 'el', 'ha', 'hi', 'kn', 'an']) J[k + 'R'] = mirror(J[k + 'L']);
  return { J, s, a, dy };
}

function placePad({ def, g }, J, dy, k) {
  let x, y, rot = 0;
  if (def.at) { x = def.at[0]; y = def.at[1] + dy; }
  else {
    const side = def.limb.endsWith('L') ? 'L' : 'R';
    const [A, B] = def.limb.startsWith('uarm') ? [J['sh' + side], J['el' + side]] : [J['hi' + side], J['kn' + side]];
    [x, y] = along(A, B, def.t);
    rot = angle(A, B);
    if (rot > 90) rot -= 180; if (rot < -90) rot += 180;
  }
  g.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${rot.toFixed(1)}) scale(${k.toFixed(3)})`);
  g.style.display = k <= 0.001 ? 'none' : '';
}

const steps = [...section.querySelectorAll('.story__step')];
// where the figure should be while each step is on screen
// each step ends on a finished pose: dressed, pads on, current, back shown, two squats done, flex
const anchors = [.14, .3, .42, .66, .93, 1];
let current = -1;
function render(p) {
  const { J, a, dy } = pose(p);
  $('thighL').setAttribute('d', line(J.hiL, J.knL));
  $('calfL').setAttribute('d', line(J.knL, J.anL));
  $('footL').setAttribute('d', line([J.anL[0] - 2, 556], [J.anL[0] - 36, 560]));
  $('thighR').setAttribute('d', line(J.hiR, J.knR));
  $('calfR').setAttribute('d', line(J.knR, J.anR));
  $('footR').setAttribute('d', line([J.anR[0] + 2, 556], [J.anR[0] + 36, 560]));
  $('uarmL').setAttribute('d', line(J.shL, J.elL));
  $('farmL').setAttribute('d', line(J.elL, J.haL));
  $('uarmR').setAttribute('d', line(J.shR, J.elR));
  $('farmR').setAttribute('d', line(J.elR, J.haR));
  for (const side of ['L', 'R']) {
    const b = along(J['sh' + side], J['el' + side], .5);
    $('bicep' + side).setAttribute('cx', b[0]); $('bicep' + side).setAttribute('cy', b[1]);
    $('bicep' + side).style.opacity = clamp((a - .4) / .4);
    const h = J['ha' + side];
    $('hand' + side).setAttribute('cx', h[0]); $('hand' + side).setAttribute('cy', h[1] - 10 * a);
    $('hand' + side).setAttribute('r', lerp(13, 19, a));
    $('strapArm' + side).setAttribute('d', perp(J['sh' + side], J['el' + side], .74, 34));
    $('strapLeg' + side).setAttribute('d', perp(J['hi' + side], J['kn' + side], .8, 50));
  }
  $('upper').setAttribute('transform', `translate(0 ${dy.toFixed(1)})`);

  // suit goes on
  const suitT = ease(seg(p, .02, .13));
  $('suit-clip-rect').setAttribute('height', (260 * suitT).toFixed(1));
  const strapsOn = seg(p, .1, .14);
  for (const id of ['strapArmL', 'strapArmR', 'strapLegL', 'strapLegR']) $(id).style.opacity = strapsOn;

  // turn front -> back -> front
  const deg = p < .64 ? 180 * ease(seg(p, .5, .6)) : 180 - 180 * ease(seg(p, .68, .76));
  const sx = Math.cos(deg * Math.PI / 180);
  const back = deg > 90;
  $('turn').setAttribute('transform', `translate(200 0) scale(${Math.max(Math.abs(sx), .02).toFixed(3)} 1) translate(-200 0)`);
  $('pads-front').style.display = back ? 'none' : '';
  $('pads-back').style.display = back ? '' : 'none';
  $('wires').style.display = back ? 'none' : '';
  $('zip').style.display = back ? '' : 'none';

  // pads pop in one by one; back pads the first time the back is shown
  const frontT = seg(p, .16, .3) * padsFront.length;
  padsFront.forEach((pd, i) => placePad(pd, J, dy, ease(clamp(frontT - i))));
  const backT = seg(p, .58, .66) * padsBack.length;
  padsBack.forEach((pd, i) => placePad(pd, J, dy, ease(clamp(backT - i))));

  // current flows once every pad is on
  const live = p > .31;
  rig.classList.toggle('is-live', live);
  $('wires').style.opacity = seg(p, .31, .36);
  const belt = [200, 296 + dy];
  [padsFront[2], padsFront[3], padsFront[10], padsFront[11]].forEach((pd, i) => {
    const m = pd.g.getAttribute('transform').match(/translate\(([-\d.]+) ([-\d.]+)\)/);
    const tx = +m[1], ty = +m[2];
    const cx = (belt[0] + tx) / 2 + (tx < 200 ? -18 : 18);
    wires[i].setAttribute('d', `M${belt[0]} ${belt[1]} Q${cx.toFixed(1)} ${((belt[1] + ty) / 2).toFixed(1)} ${tx} ${ty}`);
  });

}

if (reduceStory) {
  render(.31);                 // dressed, pads on, standing; text stays as a plain list
} else {
  section.classList.add('story--live');
  let ems3d = null, lastP = 0;
  render(0);
  // the steps move sideways (swipe, drag, trackpad, arrow keys or the buttons); each step then plays out
  // on its own, card by card: the figure dresses itself, the pads go on, it turns, it squats; never left half-way
  const bar = [...section.querySelectorAll('.story__bar span')];
  const pin = section.querySelector('.story__pin');
  const nav = section.querySelector('.story__nav');
  const count = nav.querySelector('.story__count b');
  const [prev, next] = nav.querySelectorAll('.story__arrow');
  // the two squats (progress .78–.93) keep their own tempo, about 1.4 s each, but only on the squat step itself;
  // passing through it the figure skips them (it stands at both ends), so it never trails behind the cards
  const SQUAT = [.78, .93], SQUAT_MS = 2900, STAND = [.78, .855, .93];
  const move = d => Math.min(1500, 650 + Math.abs(d) * 1800);
  const squatMs = d => Math.abs(d) / (SQUAT[1] - SQUAT[0]) * SQUAT_MS;
  let tween = 0;
  const playTo = target => {
    cancelAnimationFrame(tween);
    const legs = [];
    let from = lastP;
    const add = (to, dur, even) => { if (Math.abs(to - from) > 1e-4) legs.push({ from, d: to - from, dur, even }); from = to; };
    const up = target > from;
    if (up && target === SQUAT[1]) {
      if (from < SQUAT[0]) add(SQUAT[0], move(SQUAT[0] - from));
      add(SQUAT[1], squatMs(SQUAT[1] - from), true);
    } else {
      // caught mid-squat by the next step: stand up quickly first
      if (from > SQUAT[0] + 1e-4 && from < SQUAT[1] - 1e-4) {
        const stand = up ? STAND.find(v => v > from) : STAND.findLast(v => v < from);
        add(stand, squatMs(stand - from) * .4, true);
      }
      if (up ? from < SQUAT[1] && target > SQUAT[1] : from > SQUAT[0] && target < SQUAT[0]) {
        const [enter, leave] = up ? SQUAT : [SQUAT[1], SQUAT[0]];
        if (up ? from < enter : from > enter) add(enter, move(enter - from));
        from = leave;
      }
      add(target, move(target - from));
    }
    if (!legs.length) return;
    let leg = 0, t0 = performance.now();
    const frame = now => {
      const L = legs[leg];
      const k = clamp((now - t0) / L.dur);
      // the squat itself already slows at the bottom and top, so its leg runs at even speed
      const e = L.even ? k : -(Math.cos(Math.PI * k) - 1) / 2;
      lastP = L.from + L.d * e;
      render(lastP);
      if (ems3d) ems3d.setProgress(lastP);
      if (k >= 1) { leg++; t0 = now; }
      if (leg < legs.length) tween = requestAnimationFrame(frame);
    };
    tween = requestAnimationFrame(frame);
  };
  const go = i => {
    const idx = clamp(i, 0, steps.length - 1);
    if (idx === current) return;
    if (current >= 0) nav.classList.add('is-used');
    current = idx;
    steps.forEach((el, j) => { el.classList.toggle('is-active', j === idx); el.classList.toggle('is-past', j < idx); });
    bar.forEach((b, j) => b.classList.toggle('is-on', j <= idx));
    count.textContent = idx + 1;
    prev.disabled = idx === 0;
    next.disabled = idx === steps.length - 1;
    playTo(anchors[idx]);
  };
  section.classList.add('story--stack');
  nav.hidden = false;
  prev.disabled = true;
  // the first card comes in once the stage is mostly on screen; until then the figure waits undressed
  new IntersectionObserver(([e]) => { if (e.isIntersecting && current < 0) go(0); }, { threshold: .5 }).observe(pin);

  prev.addEventListener('click', () => go(current - 1));
  next.addEventListener('click', () => go(current + 1));
  bar.forEach((b, j) => b.addEventListener('click', () => go(j)));
  section.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); go(current + (e.key === 'ArrowRight' ? 1 : -1)); }
  });
  // swipe on phones, drag with the mouse; vertical page scrolling stays untouched (touch-action: pan-y)
  let sx = null, sy = 0;
  pin.addEventListener('pointerdown', e => { if (e.button === 0 && !e.target.closest('a, button')) { sx = e.clientX; sy = e.clientY; } });
  pin.addEventListener('pointerup', e => {
    if (sx === null) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    sx = null;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.2) go(current + (dx < 0 ? 1 : -1));
  });
  pin.addEventListener('pointercancel', () => { sx = null; });
  // two-finger sideways swipe on a trackpad: one step per gesture (the momentum tail is swallowed), no browser back-swipe
  let acc = 0, lock = 0;
  pin.addEventListener('wheel', e => {
    if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
    e.preventDefault();
    const now = performance.now();
    if (now < lock) { lock = now + 220; return; }
    acc += e.deltaX;
    if (Math.abs(acc) > 40) { go(current + Math.sign(acc)); acc = 0; lock = now + 500; }
  }, { passive: false });

  // the 3D mannequin loads only when the story is near, and never before the page has finished loading
  // and gone quiet, so it cannot hold up the first screen; the SVG figure stays as the fallback
  const holder = $('ems-3d');
  const settled = new Promise(r => {
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 800 }) : setTimeout(r, 200));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
  });
  const gl = 'WebGL2RenderingContext' in window;
  if (gl) {
    let started = false;
    new IntersectionObserver(async ([e]) => {
      if (ems3d) ems3d.setActive(e.isIntersecting);
      if (!e.isIntersecting || started) return;
      started = true;
      try {
        await settled;
        const { createEms3D } = await import('../scripts/ems3d.js');
        ems3d = await createEms3D(holder, { modelUrl: '/model/ems-manken.glb', seatsUrl: '/model/ems-pedler.json' });
        ems3d.setProgress(lastP);
        holder.parentElement.classList.add('is-3d');
        holder.parentElement.classList.remove('is-3d-wait');
        document.addEventListener('goal:change', ev => ems3d.setGoal(ev.detail));
      } catch (err) {
        // 3D failed: bring the drawn figure back
        holder.parentElement.classList.remove('is-3d-wait');
        console.warn('3D figür yüklenemedi, çizim kullanılıyor', err);
      }
    }, { rootMargin: '600px 0px' }).observe(section);
  }
}
</script>
</Base>
