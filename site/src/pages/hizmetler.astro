---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import BolgeFigur from '../components/BolgeFigur.astro';
import { isletme, whatsappLinki } from '../data/isletme';
import { hizmetler } from '../data/hizmetler';

const [zay, sik, inc, bel] = hizmetler;
const ad = (h: typeof zay) => (h as { kisaAd?: string }).kisaAd ?? h.ad;
---
<Base yol="/hizmetler">
<Nav tema="acik" />

<main>
  <!-- the slash cut into the Profit EMS logo, at poster scale, runs every part of this page -->
  <section class="h-hero" aria-labelledby="hizmetler-baslik">
    <div class="h-hero__band" aria-hidden="true"><span></span></div>
    <div class="h-hero__text">
      <h1 class="h-hero__title" id="hizmetler-baslik">
        <span class="line"><span>Hedefini</span></span>{" "}
        <span class="line"><span>seç</span></span>
      </h1>
      <p class="h-hero__lead" data-rise>{isletme.adres.ilce}'daki stüdyomuzda dört hedef için EMS antrenmanı. Her hedefte kıyafetteki farklı pedler çalışır.</p>
      <nav aria-label="Hizmetler">
        <ul class="h-hero__list">
          {hizmetler.map(h => <li data-rise><a href={`#${h.id}`}>{h.ad}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  <!-- 1 · photograph cut on the slant, words beside it -->
  <section class="s-a" id={zay.id} aria-labelledby="t-zay">
    <div class="frame frame--r s-a__img"><figure class="cut cut--r"><img src={zay.gorsel} alt={zay.alt} width="1440" height="1080" decoding="async"></figure></div>
    <div class="s-a__text">
      <h2 id="t-zay" data-rise>{ad(zay)}</h2>
      <p data-rise>{zay.metin}</p>
      <div class="zones" data-rise>
        <div class="zones__fig"><BolgeFigur zones={zay.bolge} etiket={`${zay.ad} için çalışan bölgeler`} /></div>
        <p><strong>Çalışan bölgeler</strong>{zay.bolgeler}</p>
      </div>
    </div>
  </section>

  <!-- 2 · full-bleed photograph on a slanted band, words on it -->
  <section class="s-b" id={sik.id} aria-labelledby="t-sik">
    <img class="s-b__img" src={sik.gorsel} alt={sik.alt} width="1440" height="1080" loading="lazy" decoding="async">
    <div class="s-b__text">
      <h2 id="t-sik" data-rise>{ad(sik)}</h2>
      <p data-rise>{sik.metin}</p>
    </div>
    <div class="s-b__zones" data-rise>
      <div class="zones__fig"><BolgeFigur zones={sik.bolge} koyu etiket={`${sik.ad} için çalışan bölgeler`} /></div>
      <p><strong>Çalışan bölgeler</strong>{sik.bolgeler}</p>
    </div>
  </section>

  <!-- 3 · words lead, the photograph cuts the other way -->
  <section class="s-c" id={inc.id} aria-labelledby="t-inc">
    <div class="s-c__text">
      <h2 id="t-inc" data-rise>{ad(inc)}</h2>
      <p data-rise>{inc.metin}</p>
      <div class="zones" data-rise>
        <div class="zones__fig"><BolgeFigur zones={inc.bolge} etiket={`${inc.ad} için çalışan bölgeler`} /></div>
        <p><strong>Çalışan bölgeler</strong>{inc.bolgeler}</p>
      </div>
    </div>
    <div class="frame frame--l s-c__img"><figure class="cut cut--l"><img src={inc.gorsel} alt={inc.alt} width="1440" height="1080" loading="lazy" decoding="async"></figure></div>
  </section>

  <!-- 4 · the black chapter -->
  <section class="s-d" id={bel.id} aria-labelledby="t-bel">
    <div class="frame frame--r s-d__img"><figure class="cut cut--r"><img src={bel.gorsel} alt={bel.alt} width="1440" height="1080" loading="lazy" decoding="async"></figure></div>
    <div class="s-d__text">
      <h2 id="t-bel" data-rise>{ad(bel)}</h2>
      <p data-rise>{bel.metin}</p>
      <div class="zones" data-rise>
        <div class="zones__fig"><BolgeFigur zones={bel.bolge} koyu etiket={`${bel.ad} için çalışan bölgeler`} /></div>
        <p><strong>Çalışan bölgeler</strong>{bel.bolgeler}</p>
      </div>
    </div>
  </section>

  <!-- closing band, slanted like the logo -->
  <section class="h-cta" aria-labelledby="uygun-baslik">
    <h2 id="uygun-baslik" data-rise>Hangisi sana uygun?</h2>
    <p data-rise>Hedefini yaz, sana EMS hakkında bilgi verelim. Bir sağlık sorunun varsa onu da belirt.</p>
    <div class="h-cta__actions" data-rise>
      <a class="btn btn--light" href={whatsappLinki('Merhaba, hangi EMS hizmetinin bana uygun olduğunu öğrenmek istiyorum.')} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp'tan yaz</a>
      <a class="btn btn--ghost" href={`tel:${isletme.telefonUluslararasi}`}>Ara: {isletme.telefon}</a>
    </div>
  </section>
</main>
</Base>

<style>
  /* one display treatment for every heading on the page */
  h1, h2 {
    margin: 0; text-transform: uppercase; font-style: italic; font-weight: 800;
    font-variation-settings: "wdth" 62; line-height: .92; letter-spacing: -0.02em;
  }
  h2 { font-size: clamp(3.5rem, 8vw, 8.5rem); margin-bottom: 28px; }
  p { margin: 0 0 18px; max-width: 40ch; font-size: clamp(1.125rem, 1rem + .35vw, 1.3125rem); }

  /* the logo's slash: every photograph is cut on the same slant */
  .cut { margin: 0; overflow: hidden; }
  .cut img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cut--r { clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%); }
  .cut--l { clip-path: polygon(0 0, 86% 0, 100% 100%, 14% 100%); }
  .cut { transition: clip-path 1.1s cubic-bezier(.22, 1, .36, 1); }
  /* a flat red slab in the same slant sits behind every photograph and slides out once it has opened */
  .frame { position: relative; isolation: isolate; }
  .frame .cut { position: relative; z-index: 1; height: 100%; }
  .frame::before {
    content: ""; position: absolute; inset: 0; z-index: 0; background: var(--accent);
    transform: translate(var(--slab-x, 28px), var(--slab-y, 28px));
    transition: transform 1s cubic-bezier(.22, 1, .36, 1) .5s, opacity .4s .5s;
  }
  .frame--r::before { clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%); }
  .frame--l::before { clip-path: polygon(0 0, 86% 0, 100% 100%, 14% 100%); --slab-x: -28px; }
  :global(.js) .frame:not(.is-open)::before { transform: none; opacity: 0; }
  :global(.js) .cut--r:not(.is-open) { clip-path: polygon(52% 0, 54% 0, 48% 100%, 46% 100%); }
  :global(.js) .cut--l:not(.is-open) { clip-path: polygon(46% 0, 48% 0, 54% 100%, 52% 100%); }


  /* hero: a flat red slash enters from the right */
  .h-hero { position: relative; overflow: hidden; min-height: calc(100svh - 88px); display: flex; align-items: center; padding: 4vh var(--margin) 12vh; }
  .h-hero__band {
    position: absolute; top: -10%; bottom: -10%; right: -14vw; width: 66vw;
    background: var(--accent); clip-path: polygon(36% 0, 100% 0, 64% 100%, 0 100%);
  }
  .h-hero__band span {
    position: absolute; inset: 0; background: var(--accent-deep);
    clip-path: polygon(30% 0, 34% 0, 2% 100%, -2% 100%);
  }
  .h-hero__text { position: relative; z-index: 1; max-width: 760px; }
  .h-hero__title { font-size: clamp(4.5rem, 12vw, 12rem); margin-bottom: 32px; }
  .h-hero__title .line { display: block; overflow: hidden; padding: .03em .06em .02em 0; }
  .h-hero__title .line > span { display: inline-block; }
  .h-hero__lead { max-width: 36ch; margin-bottom: 40px; }
  .h-hero__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .h-hero__list a {
    display: inline-flex; align-items: center; gap: 18px; padding: 6px 0;
    text-decoration: none; font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.5rem); font-weight: 700; letter-spacing: -0.01em;
    transition: color .2s, transform .25s var(--ease-out);
  }
  .h-hero__list a::before {
    content: ""; width: 34px; height: 12px; flex: none; background: var(--ink);
    clip-path: polygon(30% 0, 100% 0, 70% 100%, 0 100%); transition: background-color .2s, width .25s var(--ease-out);
  }
  .h-hero__list a:hover { color: var(--accent); transform: translateX(6px); }
  .h-hero__list a:hover::before { background: var(--accent); width: 52px; }

  .zones { display: grid; grid-template-columns: 96px 1fr; gap: 20px; align-items: center; margin: 8px 0 28px; }
  .zones__fig { width: 96px; }
  .zones p, .s-b__zones p { margin: 0; color: var(--muted); }
  .zones strong, .s-b__zones strong { display: block; color: var(--ink); font-weight: 700; }
  .zones { margin-bottom: 0; }

  /* the red slabs may run past the screen edge; cut them there */
  .s-a, .s-c, .s-d { overflow-x: hidden; overflow-x: clip; }

  /* 1 */
  .s-a { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px var(--margin); align-items: center; padding: 160px var(--margin); scroll-margin-top: 0; }
  .s-a__img { aspect-ratio: 4 / 3; margin-left: calc(-1 * var(--margin)); }

  /* 2 */
  .s-b {
    position: relative; isolation: isolate; color: #fff; min-height: 92svh;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; gap: 48px var(--margin);
    padding: 22vh var(--margin) 14vh;
    clip-path: polygon(0 9vh, 100% 0, 100% calc(100% - 9vh), 0 100%);
  }
  .s-b__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .s-b::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(0, 0, 0, .5) 0%, rgba(0, 0, 0, .45) 45%, rgba(0, 0, 0, .9) 85%); } /* neutral scrim under text on a photo */
  .s-b__zones { display: grid; grid-template-columns: 96px 1fr; gap: 20px; align-items: center; justify-self: end; color: #fff; max-width: 360px; }
  .s-b__zones p { color: var(--on-dark-muted); }
  .s-b__zones strong { color: #fff; }
  .s-b__zones .zones__fig { width: 96px; }

  /* 3 */
  .s-c { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px var(--margin); align-items: center; padding: 160px var(--margin); }
  .s-c__img { aspect-ratio: 4 / 3; margin-right: calc(-1 * var(--margin)); }

  /* 4 */
  .s-d { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 48px var(--margin); align-items: center; padding: 160px var(--margin); background: var(--ink); color: #fff; }
  .s-d__img { aspect-ratio: 1 / 1; }
  .s-d .zones p { color: var(--on-dark-muted); }
  .s-d .zones strong { color: #fff; }

  /* closing band */
  .h-cta { background: var(--accent); color: #fff; padding: calc(140px + 8vh) var(--margin) 140px; clip-path: polygon(0 8vh, 100% 0, 100% 100%, 0 100%); margin-top: -8vh; position: relative; }
  .h-cta h2 { margin-bottom: 24px; }
  .h-cta p { max-width: 46ch; margin-bottom: 32px; }
  .h-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn--ghost { background: rgba(0, 0, 0, .18); color: #fff; }
  .btn--ghost:hover { background: rgba(0, 0, 0, .32); }

  :global(.js) .h-hero__title .line > span { transform: translateY(105%); }
  :global(.js) [data-rise] { opacity: 0; transform: translateY(22px); }
  :global(.is-in) .h-hero__title .line > span, :global(.is-in) [data-rise] { opacity: 1; transform: none; transition: transform .8s var(--ease-out), opacity .8s; }

  @media (max-width: 860px) {
    .h-hero { min-height: 0; padding: 4vh var(--margin) 96px; align-items: flex-start; }
    .h-hero__band { top: 0; bottom: auto; height: 150px; right: -30vw; width: 100vw; }
    .h-hero__title { font-size: 24vw; margin-top: 150px; }
    .s-a, .s-c, .s-d { grid-template-columns: 1fr; padding: 96px var(--margin); }
    .s-a__img, .s-c__img { margin: 0 calc(-1 * var(--margin)); }
    .s-c__img { order: -1; }
    .s-b { grid-template-columns: 1fr; padding: 16vh var(--margin) 12vh; min-height: 0; }
    .s-b__zones { justify-self: stretch; max-width: none; }
    .s-b::before { background: linear-gradient(180deg, rgba(0, 0, 0, .45) 0%, rgba(0, 0, 0, .55) 45%, rgba(0, 0, 0, .9) 75%); } /* scrim */
    .h-cta { padding: calc(96px + 6vh) var(--margin) 96px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .h-hero__title .line > span, :global(.js) [data-rise] { opacity: 1; transform: none; }
    :global(.js) .cut--r:not(.is-open) { clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%); }
    :global(.js) .cut--l:not(.is-open) { clip-path: polygon(0 0, 86% 0, 100% 100%, 14% 100%); }
  }
</style>

<script>
import { animate, stagger, inView } from 'motion';
window.__motion = true;
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (reduce) { document.body.classList.add('is-in'); }
else {
  const ease = [0.22, 1, 0.36, 1];
  animate('.h-hero__title .line > span', { y: ['105%', '0%'] }, { type: 'spring', stiffness: 140, damping: 20, delay: stagger(0.09) });
  animate('.h-hero__band', { x: ['40%', '0%'] }, { duration: 1.1, ease });
  document.querySelectorAll('.h-hero, .s-a, .s-b, .s-c, .s-d, .h-cta').forEach(block => {
    inView(block, () => {
      animate(block.querySelectorAll('[data-rise]'), { opacity: [0, 1], y: [22, 0] }, { duration: 0.7, ease, delay: stagger(0.08, { startDelay: 0.15 }) });
    }, { amount: 0.15 });
  });
}
</script>
<script is:inline>
setTimeout(() => { if (!window.__motion) document.body.classList.add('is-in'); }, 1500);

// signature: each photograph opens out of a thin slash into its slanted cut.
// Runs on the browser's own IntersectionObserver so it never waits for a download.
(() => {
  const cuts = document.querySelectorAll('.cut');
  const open = el => { el.classList.add('is-open'); el.closest('.frame')?.classList.add('is-open'); };
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) { cuts.forEach(open); return; }
  const io = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) { open(e.target); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
  cuts.forEach(el => io.observe(el));
})();
</script>
