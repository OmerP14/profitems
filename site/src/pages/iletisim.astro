---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { isletme, whatsappLinki, yolTarifiLinki, haritaLinki, haritaGomme } from '../data/isletme';
const { acilis, kapanis } = isletme.saatler;
const saat = (t: string) => Number(t.split(':')[0]) + Number(t.split(':')[1]) / 60;
const acikBas = (saat(acilis) / 24) * 100;
const acikGen = ((saat(kapanis) - saat(acilis)) / 24) * 100;
---
<Base yol="/iletisim">
<Nav tema="acik" />

<main>
  <!-- first screen: the page name at poster size; on the right, today drawn as a 24-hour strip -->
  <section class="reach" aria-labelledby="iletisim-baslik">
    <h1 class="reach__title" id="iletisim-baslik">
      <span class="line"><span>Bize</span></span>{" "}
      <span class="line"><span>ulaş</span></span>
    </h1>

    <div class="reach__side">
      <div class="day" data-rise>
        <p class="day__status" id="durum" aria-live="polite">{isletme.saatler.metin} açığız.</p>
        <div class="day__strip" style={`--bas:${acikBas}%; --gen:${acikGen}%`} aria-hidden="true">
          <span class="day__open"></span>
          <span class="day__now" id="simdi" hidden></span>
        </div>
        <div class="day__scale" style={`--bas:${acikBas}%; --gen:${acikGen}%`} aria-hidden="true">
          <span>00</span><span class="day__o">{acilis}</span><span class="day__c">{kapanis}</span><span>24</span>
        </div>
      </div>

      <a class="wa" data-rise href={whatsappLinki('Merhaba, randevu almak istiyorum.')} target="_blank" rel="noopener">
        <WhatsAppIcon />
        <span>WhatsApp'tan yaz</span>
      </a>

      <div class="alt" data-rise>
        <a href={`tel:${isletme.telefonUluslararasi}`}><small>Ara</small>{isletme.telefon}</a>
        <a href={isletme.instagram} target="_blank" rel="noopener"><small>Instagram</small>{isletme.instagramKullanici}</a>
      </div>
    </div>
  </section>

  <!-- how to find the door: printed like a route slip, the map runs to the edge beside it -->
  <section class="find" aria-labelledby="bul-baslik">
    <div class="find__left">
      <h2 id="bul-baslik" data-rise>Nasıl bulunur?</h2>
      <div class="slip" data-rise>
        <ol class="slip__rows">
          <li><span>{isletme.adres.il}, {isletme.adres.ilce}</span><i></i><span>Kılınçarslan Mah.</span></li>
          <li><span>Urfa Sokak</span><i></i><span>No:9C</span></li>
          <li><span>{isletme.adres.bina}</span><i></i><span>{isletme.adres.postaKodu}</span></li>
          <li><span>Şefikcan Kafe giriş kapısı</span><i></i><span>karşısı</span></li>
        </ol>
        <p class="slip__end"><span>{isletme.ad}</span><span>{acilis}–{kapanis}</span></p>
      </div>
      <div class="find__actions" data-rise>
        <a class="btn" href={yolTarifiLinki} target="_blank" rel="noopener">Yol tarifi al</a>
        <a class="btn btn--quiet" href={haritaLinki} target="_blank" rel="noopener">Haritada aç</a>
      </div>
      <address class="sr-only">{isletme.adres.sokak}, {isletme.adres.postaKodu} {isletme.adres.ilce}/{isletme.adres.il}</address>
    </div>
    <div class="find__map">
      <iframe src={haritaGomme} title="Profit EMS konumu, Google Haritalar" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <!-- the certificate as a plaque on a dark wall -->
  <section class="plaque" aria-labelledby="belge-baslik">
    <div class="plaque__band" aria-hidden="true"><span></span></div>
    <div class="plaque__text">
      <h2 id="belge-baslik" data-rise>Belgeli tesis</h2>
      <p data-rise>Profit EMS, Türkiye Cimnastik Federasyonu yeterlilik belgesine sahip bir tesis.</p>
      <p data-rise>Belgedeki QR kodu telefonunla okut, tesis bilgisini kendin doğrula.</p>
    </div>
    <div class="plaque__wrap" data-rise><figure class="plaque__img" id="plaket">
      <img src="/img/tcf-belge.webp" alt="Türkiye Cimnastik Federasyonu yeterlilik belgesi: Bu tesis Türkiye Cimnastik Federasyonu yeterlilik belgesine sahiptir. Tesis hakkında bilgi için QR kodu okutunuz." width="856" height="1000" decoding="async" fetchpriority="low">
    </figure></div>
  </section>
</main>
</Base>

<style>
  h1, h2 {
    margin: 0; text-transform: uppercase; font-style: italic; font-weight: 800;
    font-variation-settings: "wdth" 62; line-height: .92; letter-spacing: -0.02em;
  }

  /* ---------- first screen on the dark gym photo ---------- */
  .reach {
    position: relative; isolation: isolate; color: #fff;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px var(--margin); align-items: end;
    margin-top: -88px; padding: calc(88px + 8vh) var(--margin) 9vh; min-height: 100svh;
    background: #000 url(/img/iletisim-2560.jpg) center 35% / cover no-repeat;
  }
  .reach::before { content: ""; position: absolute; inset: 0; z-index: -1; background: rgba(0, 0, 0, .45); }
  .reach__title { font-size: clamp(5rem, 15vw, 15rem); }
  .reach__title .line { display: block; overflow: hidden; padding: .03em .06em .02em 0; }
  .reach__title .line > span { display: inline-block; }

  .day { margin-bottom: 36px; }
  .day__status { margin: 0 0 16px; font-size: clamp(1.25rem, 1.05rem + .8vw, 1.75rem); font-weight: 700; line-height: 1.2; }
  .day__strip { position: relative; height: 14px; background: rgba(255, 255, 255, .18); }
  .day__open { position: absolute; top: 0; bottom: 0; left: var(--bas); width: var(--gen); background: var(--accent); transform-origin: left; }
  .day__now { position: absolute; top: -8px; bottom: -8px; width: 4px; margin-left: -2px; background: #fff; }
  .day__scale { position: relative; height: 1.5em; margin-top: 10px; font-size: var(--step-small); color: var(--on-dark-muted); font-variant-numeric: tabular-nums; }
  .day__scale span { position: absolute; top: 0; }
  .day__scale span:first-child { left: 0; }
  .day__scale span:last-child { right: 0; }
  .day__o { left: var(--bas); transform: translateX(-50%); color: #fff; font-weight: 600; }
  .day__c { left: calc(var(--bas) + var(--gen)); transform: translateX(-50%); color: #fff; font-weight: 600; }

  .wa {
    display: flex; align-items: center; gap: 16px; min-height: 84px; padding: 0 28px;
    background: var(--accent); color: #fff; text-decoration: none;
    font-size: clamp(1.5rem, 1.15rem + 1.3vw, 2.25rem); font-weight: 700; letter-spacing: -0.01em;
    transition: background-color .2s, transform .2s var(--ease-out);
  }
  .wa :global(svg) { width: 1em; height: 1em; flex: none; }
  .wa:hover { background: #c90f33; }
  .wa:active { transform: scale(.985); }

  .alt { display: grid; grid-template-columns: 1fr 1fr; gap: var(--margin); margin-top: 28px; }
  .alt a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; font-size: clamp(1.25rem, 1rem + .9vw, 1.75rem); font-weight: 700; line-height: 1.15; }
  .alt small { font-size: var(--step-small); font-weight: 500; color: var(--on-dark-muted); }
  .alt a:hover { color: var(--accent); }

  :global(.nav--light) { color: #fff; }
  :global(.nav--light .nav__logo img) { content: url(/img/logo-light.svg); }
  :global(.nav--light .nav__menu) { background: #fff; color: var(--ink); }
  :global(.nav--light .nav__links a[aria-current="page"]) { color: var(--accent); }

  /* ---------- route slip + map ---------- */
  .find { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px var(--margin); align-items: stretch; padding: 160px 0 160px var(--margin); }
  .find h2 { font-size: clamp(3.25rem, 6.5vw, 6.5rem); margin-bottom: 40px; }
  .slip {
    background: #fff; padding: 32px 32px 56px; max-width: 480px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), 96% 100%, 92% calc(100% - 12px), 88% 100%, 84% calc(100% - 12px), 80% 100%, 76% calc(100% - 12px), 72% 100%, 68% calc(100% - 12px), 64% 100%, 60% calc(100% - 12px), 56% 100%, 52% calc(100% - 12px), 48% 100%, 44% calc(100% - 12px), 40% 100%, 36% calc(100% - 12px), 32% 100%, 28% calc(100% - 12px), 24% 100%, 20% calc(100% - 12px), 16% 100%, 12% calc(100% - 12px), 8% 100%, 4% calc(100% - 12px), 0 100%);
  }
  .slip__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; font-size: 1.0625rem; }
  .slip__rows li { display: flex; align-items: baseline; gap: 10px; }
  .slip__rows li span:first-child { font-weight: 600; }
  .slip__rows li span:last-child { color: var(--muted); white-space: nowrap; }
  .slip__rows i { flex: 1; min-width: 16px; height: 4px; background: radial-gradient(circle, var(--ink) 1.5px, transparent 2px) 0 50% / 9px 4px repeat-x; opacity: .45; } /* dot leader, not a gradient */
  .slip__end {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    margin: 28px -32px 0; padding: 0 32px; min-height: 48px;
    background: var(--ink); color: #fff; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .find__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .btn--quiet { background: var(--surface); color: var(--ink); }
  .btn--quiet:hover { background: #cdd5da; }
  .find__map { min-height: 560px; background: var(--surface); }
  .find__map iframe { display: block; width: 100%; height: 100%; min-height: 560px; border: 0; filter: grayscale(.9) contrast(1.05); }

  /* ---------- certificate plaque ---------- */
  .plaque { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 48px var(--margin); align-items: center; background: var(--ink); color: #fff; padding: 160px var(--margin); min-height: 100svh; overflow: hidden; }
  /* the logo's red slash fills the right half behind the plaque */
  .plaque__band {
    position: absolute; z-index: -1; top: 0; bottom: 0; right: -6vw; width: 62vw;
    background: var(--accent); clip-path: polygon(34% 0, 100% 0, 66% 100%, 0 100%);
    transition: transform 1.1s cubic-bezier(.22, 1, .36, 1);
  }
  .plaque__band span { position: absolute; inset: 0; background: var(--accent-deep); clip-path: polygon(28% 0, 33% 0, 4% 100%, -1% 100%); }
  :global(.js) .plaque:not(.is-open) .plaque__band { transform: translateX(70%); }
  .plaque h2 { font-size: clamp(3.25rem, 7vw, 6.5rem); margin-bottom: 28px; }
  .plaque p { margin: 0 0 14px; max-width: 36ch; font-size: clamp(1.125rem, 1rem + .4vw, 1.375rem); }
  .plaque__wrap { justify-self: center; }
  .plaque__img { margin: 0; transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) rotate(-4deg); transition: transform .35s var(--ease-out); animation: float 6s ease-in-out infinite; }
  @keyframes float { 50% { translate: 0 -12px; } }
  .plaque__img img { display: block; width: min(520px, 100%); height: auto; aspect-ratio: 856 / 1000; }

  /* ---------- entrances (only when script runs) ---------- */
  :global(.js) .reach__title .line > span { transform: translateY(105%); }
  :global(.js) [data-rise] { opacity: 0; transform: translateY(22px); }
  :global(.is-in) .reach__title .line > span, :global(.is-in) [data-rise] { opacity: 1; transform: none; transition: transform .8s var(--ease-out), opacity .8s; }

  @media (min-width: 1921px), (min-width: 1200px) and (min-resolution: 2dppx) {
    .reach { background-image: url(/img/iletisim-4k.jpg); }
  }
  @media (max-width: 860px) {
    .reach {
      grid-template-columns: 1fr; gap: 40px; min-height: 0;
      margin-top: -72px; padding: calc(72px + 4vh) var(--margin) 72px;
      background-image: url(/img/iletisim-mobil.jpg); background-position: center top;
    }
    .reach::before { background: linear-gradient(180deg, rgba(0, 0, 0, .35), rgba(0, 0, 0, .7) 55%, rgba(0, 0, 0, .85)); } /* scrim under text */
    .reach__title { font-size: 26vw; }
    .wa { min-height: 72px; padding: 0 22px; }
    .day__scale span:first-child, .day__scale span:last-child { display: none; }
    .find { grid-template-columns: 1fr; padding: 96px 0 0; }
    .find__left { padding: 0 var(--margin); }
    .slip { max-width: none; padding: 26px 22px 50px; }
    .slip__end { margin: 24px -22px 0; padding: 0 22px; }
    .slip__rows { font-size: 1rem; }
    .find__map, .find__map iframe { min-height: 60vh; }
    .find__map { margin-top: 24px; }
    .plaque { grid-template-columns: 1fr; padding: 104px var(--margin); min-height: 0; }
    .plaque__band { top: auto; height: 62%; right: -30vw; width: 120vw; }
    .plaque__img { transform: rotate(-3deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .reach__title .line > span, :global(.js) [data-rise] { opacity: 1; transform: none; }
    .plaque__img { transition: none; animation: none; }
    :global(.js) .plaque:not(.is-open) .plaque__band { transform: none; }
  }
</style>

<script is:inline define:vars={{ acilis, kapanis }}>
// today, in Konya time: the status line and the "now" marker on the 24-hour strip
(() => {
  const status = document.getElementById('durum');
  const mark = document.getElementById('simdi');
  const now = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Istanbul', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
  const toMin = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
  const n = toMin(now), o = toMin(acilis), c = toMin(kapanis);
  mark.style.left = (n / 1440 * 100) + '%';
  mark.hidden = false;
  if (n >= o && n < c) {
    const left = c - n, h = Math.floor(left / 60), m = left % 60;
    const kalan = [h && `${h} saat`, m && `${m} dakika`].filter(Boolean).join(' ');
    status.textContent = `Şu an açığız. Kapanışa ${kalan} var.`;
  } else if (n < o) status.textContent = `Şu an kapalıyız. Bugün ${acilis}'da açılıyoruz.`;
  else status.textContent = `Şu an kapalıyız. Yarın ${acilis}'da açılıyoruz.`;
})();
</script>

<script>
import { animate, stagger, inView } from 'motion';
(window as any).__motion = true;
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (reduce) { document.body.classList.add('is-in'); }
else {
  const ease = [0.22, 1, 0.36, 1] as const;
  animate('.reach__title .line > span', { y: ['105%', '0%'] }, { type: 'spring', stiffness: 140, damping: 20, delay: stagger(0.09) });
  // signature: the open hours fill the strip from opening time to closing time
  animate('.day__open', { scaleX: [0, 1] }, { duration: 1.2, ease, delay: 0.5 });
  document.querySelectorAll('.reach, .find, .plaque').forEach(block => {
    inView(block, () => {
      animate(block.querySelectorAll('[data-rise]'), { opacity: [0, 1], y: [22, 0] }, { duration: 0.7, ease, delay: stagger(0.08, { startDelay: 0.2 }) });
    }, { amount: 0.15 });
  });
}
</script>
<script is:inline>
setTimeout(() => { if (!window.__motion) document.body.classList.add('is-in'); }, 1500);

// certificate section: the red slash slides in when it is reached; on desktop the plaque tilts toward the pointer
(() => {
  const sec = document.querySelector('.plaque');
  const card = document.getElementById('plaket');
  if (!('IntersectionObserver' in window)) { sec.classList.add('is-open'); return; }
  const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { sec.classList.add('is-open'); io.disconnect(); } }, { threshold: .25 });
  io.observe(sec);
  if (!matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) return;
  sec.addEventListener('pointermove', e => {
    const r = sec.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
    card.style.setProperty('--ry', (x * 18).toFixed(2) + 'deg');
    card.style.setProperty('--rx', (-y * 14).toFixed(2) + 'deg');
  });
  sec.addEventListener('pointerleave', () => { card.style.setProperty('--ry', '0deg'); card.style.setProperty('--rx', '0deg'); });
})();
</script>
