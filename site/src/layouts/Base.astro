---
import '../styles/global.css';
import Chat from '../components/Chat.astro';
import Footer from '../components/Footer.astro';
import { seo } from '../data/seo';
import { isletme, haritaLinki } from '../data/isletme';

// blog yazıları başlık/açıklamayı kendi dosyalarından verir; diğer sayfalar seo.ts'ten alır
// gizli: Google'da listelenmesin (404 sayfası gibi)
interface Props { yol: string; baslik?: string; aciklama?: string; gorsel?: string; tur?: 'website' | 'article'; gizli?: boolean }
const { yol, baslik, aciklama, gorsel, tur = 'website', gizli = false } = Astro.props;
const sayfa = baslik && aciklama ? { baslik, aciklama } : seo[yol] ?? seo['/'];
// every page gets a share picture; posts use their cover, the rest the studio card
const ogGorsel = Astro.site ? new URL(gorsel ?? '/img/paylasim.jpg', Astro.site).href : null;
const canonical = Astro.site && !gizli ? new URL(yol, Astro.site).href : null;

// Google'a "bu bir yerel işletme" diyen bilgi (schema.org)
const isletmeVerisi = {
  '@context': 'https://schema.org',
  '@type': 'HealthClub',
  name: isletme.ad,
  telephone: isletme.telefonUluslararasi,
  address: {
    '@type': 'PostalAddress',
    streetAddress: isletme.adres.sokak,
    addressLocality: isletme.adres.ilce,
    addressRegion: isletme.adres.il,
    postalCode: isletme.adres.postaKodu,
    addressCountry: 'TR',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: isletme.saatler.acilis,
    closes: isletme.saatler.kapanis,
  }],
  description: seo['/'].aciklama,
  ...(Astro.site ? { image: new URL('/img/paylasim.jpg', Astro.site).href, logo: new URL('/img/logo.svg', Astro.site).href } : {}),
  hasMap: haritaLinki,
  sameAs: [isletme.instagram],
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{sayfa.baslik}</title>
<meta name="description" content={sayfa.aciklama}>
{gizli && <meta name="robots" content="noindex">}
{canonical && <link rel="canonical" href={canonical}>}
<meta property="og:type" content={tur}>
{ogGorsel && <meta property="og:image" content={ogGorsel}>}
{ogGorsel && !gorsel && <><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"></>}
<meta property="og:image:alt" content={`${isletme.ad}, Konya EMS stüdyosu`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#e8173f">
<meta property="og:locale" content="tr_TR">
<meta property="og:site_name" content={isletme.ad}>
<meta property="og:title" content={sayfa.baslik}>
<meta property="og:description" content={sayfa.aciklama}>
{canonical && <meta property="og:url" content={canonical}>}
<script type="application/ld+json" set:html={JSON.stringify(isletmeVerisi)} />
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/archivo-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add('js');</script>
<slot name="head" />
</head>
<body>
<slot />
<Footer />
<Chat />
<script>
import { animate, press, scroll, inView } from 'motion';
const tap = { type: 'spring', stiffness: 400, damping: 20 };
// press feedback on every control
press('.goal, .btn, .chat__toggle, .chat__quick button', el => {
  animate(el, { scale: 0.95 }, tap);
  return () => animate(el, { scale: 1 }, tap);
});

// one motion language for every page: the same curve everywhere, movement tied to the scroll so it follows the finger
const EASE = [0.22, 1, 0.36, 1] as const;
if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  // the first screen leaves as you scroll on: its words drift up and fade, like a page turning over
  const words = document.querySelector<HTMLElement>('.hero__main, .h-hero__text, .e-hero__title, .b-hero__head, .k-hero__title, .p-head');
  let stage = words?.closest<HTMLElement>('section, header');
  // the scroll is measured on the outermost box that does not clip (a clipping box counts as its own scroller)
  for (let p = stage?.parentElement; stage && p && p !== document.body; p = p.parentElement) {
    if (getComputedStyle(p).overflow !== 'visible') stage = p;
  }
  if (words && stage) {
    scroll(animate(words, { y: [0, -96], opacity: [1, 0.1] }, { ease: 'linear' }), { target: stage, offset: ['start start', 'end start'] });
  }

  // large photographs settle into their frame as they come up the screen: a slow zoom-out tied to the scroll
  document.querySelectorAll<HTMLImageElement>('main img, .hs img').forEach(img => {
    const box = img.parentElement;
    if (!box || img.closest('.stage, .rail, .serit, .hg__peek, .h-show') || img.getBoundingClientRect().width < 320) return;
    const cs = getComputedStyle(box);
    // only a picture in a frame: zooming a picture that carries its own cut would zoom the cut too
    if (getComputedStyle(img).clipPath !== 'none') return;
    if (cs.overflow === 'visible') {
      if (cs.clipPath === 'none') return;
      box.style.overflow = 'clip';   // a clip-path hides the zoomed edges but would still widen the page
    }
    scroll(animate(img, { scale: [1.14, 1] }, { ease: 'linear' }), { target: img, offset: ['start end', 'center center'] });
  });

  // section headings rise from behind a mask as they arrive (the italic overhang is left room in the final state).
  // The block around the heading is watched, not the heading: browsers count a fully masked element as never visible.
  document.querySelectorAll<HTMLElement>('main h2, .hs h2').forEach(h => {
    if (h.closest('.chat, .q, .y-body')) return;
    h.style.clipPath = 'inset(0 -12% 100% -12%)';
    inView(h.parentElement ?? h, () => {
      // ends on a mask larger than the heading on every side, so nothing (accents, the italic lean) is cut afterwards
      animate(h, { clipPath: ['inset(0 -12% 100% -12%)', 'inset(-20% -12% -30% -12%)'] }, { duration: 0.9, ease: EASE });
    }, { margin: '0px 0px -15% 0px' });
  });
}
</script>
</body>
</html>
