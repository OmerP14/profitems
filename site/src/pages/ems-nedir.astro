---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { isletme, whatsappLinki } from '../data/isletme';
import { seansAkisi, engeller, sss } from '../data/sss';

// the device's impulse train, drawn with the logo's slash: bursts that start low and rise,
// the way the intensity is raised step by step in a session
const VB_W = 1440, VB_H = 160;
const darbeler: string[] = [];
{
  const grup = 8, adim = 26, bar = 13, egim = 12, bosluk = 74;
  const gruplar = Math.floor(VB_W / (grup * adim + bosluk)) + 1;
  for (let g = 0; g < gruplar; g++) {
    const h = 34 + (VB_H - 44) * (g / (gruplar - 1));   // intensity rises burst by burst
    const x0 = g * (grup * adim + bosluk);
    for (let i = 0; i < grup; i++) {
      const x = x0 + i * adim, y = VB_H - h;
      darbeler.push(`${x + egim},${y} ${x + egim + bar},${y} ${x + bar},${VB_H} ${x},${VB_H}`);
    }
  }
}

const sssVerisi = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sss.map(s => ({ '@type': 'Question', name: s.soru, acceptedAnswer: { '@type': 'Answer', text: s.cevap } })),
};

const waSaglik = whatsappLinki('Merhaba, EMS\'e başlamadan önce sormak istediğim bir sağlık durumum var.');
const waRandevu = whatsappLinki('Merhaba, randevu almak istiyorum.');
---
<Base yol="/ems-nedir">
<script slot="head" type="application/ld+json" set:html={JSON.stringify(sssVerisi)} />
<Nav tema="acik" />

<main>
  <!-- first screen: the name of the thing at poster size, the impulse train running underneath -->
  <section class="e-hero" aria-labelledby="ems-baslik">
    <h1 class="e-hero__title" id="ems-baslik">
      <span class="line"><span>EMS</span></span>{" "}
      <span class="line"><span>nedir?</span></span>
    </h1>
    <div class="e-hero__side">
      <p class="e-hero__lead" data-rise>Elektriksel kas uyarımı. Kıyafetteki pedler kaslarına hafif bir uyarı gönderir, sen basit hareketler yaparken kasların daha yoğun çalışır.</p>
      <nav aria-label="Bu sayfada">
        <ul class="e-hero__list">
          <li data-rise><a href="#uyari">Uyarı nereden gelir?</a></li>
          <li data-rise><a href="#seans">Bir seans nasıl geçer?</a></li>
          <li data-rise><a href="#sorular">Sık sorulan sorular</a></li>
          <li data-rise><a href="#kimler">Kimler yapmamalı?</a></li>
        </ul>
      </nav>
    </div>
    <svg class="pulse" viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="xMinYMax slice" aria-hidden="true">
      {darbeler.map((p, i) => <polygon points={p} style={`--i:${i}`} />)}
    </svg>
  </section>

  <!-- the body's own signal and the device's signal, side by side -->
  <section class="sig" id="uyari" aria-labelledby="uyari-baslik">
    <figure class="sig__img">
      <img src="/img/ems-nedir/vesalius-kaslar.webp" alt="Vesalius'un 16. yüzyıldan kalma gravürü: derisi olmadan, bütün kasları görünen ayakta bir insan figürü" width="900" height="1551" loading="lazy" decoding="async">
      <figcaption>Andreas Vesalius, <i>De humani corporis fabrica</i>, 16. yüzyıl. Wellcome Collection, CC BY 4.0.</figcaption>
    </figure>
    <div class="sig__text">
      <h2 id="uyari-baslik" data-rise>Uyarı nereden gelir?</h2>
      <p data-rise>Kasların, beyinden sinirler yoluyla gelen elektrik sinyaliyle kasılır. EMS bu sinyale dışarıdan destek verir: cihaz, kıyafetteki pedler üzerinden kaslara hafif bir uyarı gönderir.</p>
      <p data-rise>Sen hareket ederken kas hem kendi sinyalini hem pedden gelen uyarıyı alır. Basit bir squat bile böylece daha yoğun bir çalışmaya dönüşür.</p>
    </div>
    <div class="sig__fig" data-rise>
      <p class="sig__label">Her harekette</p>
      <ol class="rail" aria-label="Her harekette: beyin, sinir, kas">
        <li>Beyin</li><li>Sinir</li><li class="rail__kas">Kas</li>
      </ol>
      <p class="sig__label">EMS'te ayrıca</p>
      <ol class="rail rail--ems" aria-label="EMS'te ayrıca: cihaz, ped, kas">
        <li>Cihaz</li><li>Ped</li><li class="rail__kas">Kas</li>
      </ol>
    </div>
  </section>

  <!-- the principle is old: Duchenne's photographs, 1862 -->
  <section class="hist" aria-labelledby="tarih-baslik">
    <figure class="hist__img">
      <img src="/img/ems-nedir/duchenne-1862.webp" alt="1862 tarihli siyah beyaz fotoğraf: bir hekimin elindeki elektrot, yaşlı bir adamın alnındaki kası kasıyor" width="900" height="1167" loading="lazy" decoding="async">
      <figcaption>Duchenne de Boulogne, <i>Mécanisme de la physionomie humaine</i>, 1862. Cleveland Museum of Art, CC0.</figcaption>
    </figure>
    <div class="hist__text">
      <h2 id="tarih-baslik" data-rise>Yeni bir fikir değil</h2>
      <p data-rise>1862'de Fransız hekim Duchenne de Boulogne, ciltten verdiği elektrikle yüz kaslarını tek tek kasıp fotoğrafladı.</p>
      <p data-rise>Bugünkü EMS cihazları aynı ilkeyle çalışır: uyarı ciltteki pedden kasa ulaşır. Fark, bugün bütün büyük kas gruplarının aynı anda ve kontrollü bir şiddetle çalışması.</p>
    </div>
  </section>

  <!-- a session in order, beside a training clip -->
  <section class="ses" id="seans" aria-labelledby="seans-baslik">
    <div class="ses__media">
      <video class="ses__video" muted loop playsinline preload="none" poster="/video/hero-yatay.jpg" aria-hidden="true" data-src="/video/hero-yatay.mp4" data-src-narrow="/video/hero-dikey.mp4" data-poster-narrow="/video/hero-dikey.jpg"></video>
    </div>
    <div class="ses__text">
      <h2 id="seans-baslik" data-rise>Bir seans nasıl geçer?</h2>
      <ol class="ses__steps">
        {seansAkisi.map((s, i) => (
          <li data-rise style={`--seviye:${(i + 1) / seansAkisi.length}`}>
            <span class="ses__bar" aria-hidden="true"></span>
            <h3>{s.baslik}</h3>
            <p>{s.metin}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- questions -->
  <section class="faq" id="sorular" aria-labelledby="sorular-baslik">
    <h2 class="faq__title" id="sorular-baslik" data-rise>Sık sorulan sorular</h2>
    <aside class="faq__side" aria-label="Soru sor">
      <!-- stock photo until the studio's own photographs arrive -->
      <img class="faq__img" src="/img/ems-nedir/ems-antrenor-tablet.webp" alt="Antrenör EMS cihazını tabletten ayarlarken EMS kıyafetli bir kadın dambılla squat yapıyor" width="1200" height="1200" loading="lazy" decoding="async" data-rise>
      <p data-rise>Cevabını bulamadığın soruyu bize yaz.</p>
      <div class="faq__actions" data-rise>
        <a class="btn" href={whatsappLinki('Merhaba, EMS hakkında bir sorum var.')} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp'tan sor</a>
        <a class="btn btn--quiet" href={`tel:${isletme.telefonUluslararasi}`}>Ara: {isletme.telefon}</a>
      </div>
    </aside>
    <div class="faq__list">
      {sss.map(s => (
        <details class="q" data-rise>
          <summary><span>{s.soru}</span><i aria-hidden="true"></i></summary>
          <p>{s.cevap}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- who should not start, with a check the visitor can tick through -->
  <section class="kim" id="kimler" aria-labelledby="kimler-baslik">
    <div class="kim__text">
      <h2 id="kimler-baslik" data-rise>Kimler yapmamalı?</h2>
      <p data-rise>Aşağıdakilerden biri sende varsa EMS'e başlamadan önce doktoruna danış. Emin olmadığın bir durum varsa bize yaz, birlikte bakalım.</p>
    </div>
    <div class="kim__check" data-rise>
      <p class="kim__ask" id="kim-soru">Sende olanlara dokun:</p>
      <ul class="kim__list" aria-labelledby="kim-soru">
        {engeller.map(e => <li><button type="button" class="engel" aria-pressed="false">{e}</button></li>)}
      </ul>
      <div class="kim__out">
        <p id="kim-sonuc" aria-live="polite">Bir sağlık sorunun varsa ilk görüşmede bize mutlaka söyle.</p>
        <a class="btn btn--light" id="kim-wa" href={waSaglik} target="_blank" rel="noopener"><WhatsAppIcon /> <span>WhatsApp'tan sor</span></a>
      </div>
    </div>
  </section>
</main>
</Base>

<style>
  h1, h2 {
    margin: 0; text-transform: uppercase; font-style: italic; font-weight: 800;
    font-variation-settings: "wdth" 62; line-height: .92; letter-spacing: -0.02em;
  }
  h2 { font-size: clamp(3.25rem, 7vw, 7rem); margin-bottom: 32px; }
  p { margin: 0 0 18px; max-width: 42ch; font-size: clamp(1.125rem, 1rem + .35vw, 1.3125rem); }

  /* ---------- first screen ---------- */
  .e-hero {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; gap: 32px var(--margin);
    min-height: calc(100svh - 88px); padding: 4vh var(--margin) calc(clamp(110px, 13vw, 190px) + 7vh);
  }
  /* capped by height too, so the impulse train is never cut off at the bottom of a laptop screen */
  .e-hero__title { font-size: clamp(5rem, min(17vw, 26svh), 17rem); }
  .e-hero__title .line { display: block; overflow: hidden; padding: .03em .06em .02em 0; }
  .e-hero__title .line > span { display: inline-block; }
  .e-hero__side { padding-bottom: 1.2vw; }
  .e-hero__lead { max-width: 34ch; margin-bottom: 36px; font-size: clamp(1.25rem, 1.05rem + .7vw, 1.75rem); line-height: 1.3; font-weight: 500; }
  .e-hero__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .e-hero__list a {
    display: inline-flex; align-items: center; gap: 16px; padding: 6px 0;
    text-decoration: none; font-size: clamp(1.125rem, 1rem + .5vw, 1.4375rem); font-weight: 700;
    transition: color .2s, transform .25s var(--ease-out);
  }
  .e-hero__list a::before {
    content: ""; width: 26px; height: 10px; flex: none; background: var(--ink);
    clip-path: polygon(30% 0, 100% 0, 70% 100%, 0 100%); transition: background-color .2s, width .25s var(--ease-out);
  }
  .e-hero__list a:hover { color: var(--accent-deep); transform: translateX(6px); }
  .e-hero__list a:hover::before { background: var(--accent); width: 40px; }

  /* the impulse train along the bottom of the first screen */
  .pulse { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: clamp(110px, 13vw, 190px); }
  .pulse polygon { fill: var(--accent); transform-box: fill-box; transform-origin: 50% 100%; }

  /* ---------- the two signals ---------- */
  .sig {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 56px calc(var(--margin) * 3); align-items: center;
    padding: 120px var(--margin); background: var(--surface);
  }
  .sig__img { grid-row: span 2; }
  .sig__text, .sig__fig { grid-column: 2; }
  .sig__text { align-self: end; }
  .sig__fig { align-self: start; max-width: 760px; }
  /* the engraving's paper melts into the grey ground */
  .sig__img { margin: 0; align-self: stretch; display: flex; flex-direction: column; }
  .sig__img img { flex: 1; width: 100%; min-height: 0; max-height: 86svh; object-fit: contain; object-position: left center; mix-blend-mode: multiply; }
  .sig__img figcaption { margin-top: 12px; font-size: var(--step-small); color: var(--muted); max-width: 40ch; }
  .sig__label { margin: 0 0 12px; font-size: var(--step-body); font-weight: 600; color: var(--muted); }
  .rail { list-style: none; margin: 0 0 48px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 48px); position: relative; }
  .rail:last-child { margin-bottom: 0; }
  .rail li {
    position: relative; display: flex; align-items: center; justify-content: center; min-height: clamp(84px, 8vw, 120px);
    background: var(--ink); color: #fff;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2.25rem); font-weight: 800; font-style: italic; text-transform: uppercase; font-variation-settings: "wdth" 62;
    clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
  }
  .rail .rail__kas { background: var(--accent); }
  /* the signal travels from block to block: a red slash crossing each gap */
  .rail::before, .rail::after {
    content: ""; position: absolute; top: 50%; width: 22px; height: 30px; margin-top: -15px; z-index: 1;
    background: var(--accent); clip-path: polygon(40% 0, 100% 0, 60% 100%, 0 100%);
    animation: hop 2.4s var(--ease-out) infinite;
  }
  .rail::before { left: calc(33.33% - 22px); }
  .rail::after { left: calc(66.66% - 10px); animation-delay: 1.2s; }
  .rail--ems::before, .rail--ems::after { background: var(--ink); }
  .rail--ems li:not(.rail__kas) { background: #fff; color: var(--ink); }
  @keyframes hop { 0% { transform: translateX(-24px); opacity: 0; } 30%, 60% { opacity: 1; } 100% { transform: translateX(28px); opacity: 0; } }

  /* ---------- history ---------- */
  .hist {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px var(--margin); align-items: end;
    padding: 160px var(--margin); background: var(--ink); color: #fff;
  }
  .hist__img { margin: 0; }
  .hist__img img { width: 100%; height: auto; aspect-ratio: 1080 / 1400; object-fit: cover; }
  .hist__img figcaption { margin-top: 12px; font-size: var(--step-small); color: var(--on-dark-muted); max-width: 46ch; }
  .hist__text { padding-bottom: 4vh; }
  .hist p { max-width: 38ch; }

  /* ---------- a session ---------- */
  .ses { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 48px var(--margin); align-items: start; padding: 160px var(--margin); }
  .ses__media { position: sticky; top: 24px; margin-left: calc(-1 * var(--margin)); aspect-ratio: 1 / 1; overflow: hidden; background: var(--ink); clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%); }
  .ses__video { width: 100%; height: 100%; object-fit: cover; }
  .ses__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 44px; }
  .ses__steps li { display: grid; grid-template-columns: 72px 1fr; column-gap: 24px; align-items: end; }
  /* each step's bar is a little taller: the intensity is raised step by step */
  .ses__bar {
    grid-row: span 2; align-self: stretch; justify-self: start; width: 40px; min-height: 76px;
    background: var(--accent); clip-path: polygon(40% calc(100% - 100% * var(--seviye)), 100% calc(100% - 100% * var(--seviye)), 60% 100%, 0 100%);
  }
  .ses__steps h3 { margin: 0 0 6px; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; }
  .ses__steps p { margin: 0; }

  /* ---------- who should not ---------- */
  .kim {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px var(--margin); align-items: start;
    padding: calc(140px + 8vh) var(--margin) 160px; background: var(--accent); color: #fff;
    clip-path: polygon(0 8vh, 100% 0, 100% 100%, 0 100%); margin-top: -8vh;
  }
  .kim__ask { margin: 0 0 14px; font-weight: 700; }
  .kim__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .engel {
    width: 100%; height: 100%; min-height: 64px; padding: 14px 18px 14px 52px; position: relative;
    border: 0; cursor: pointer; text-align: left; font: inherit; font-size: var(--step-body); font-weight: 600; line-height: 1.3;
    background: var(--accent-deep); color: #fff; transition: background-color .18s, color .18s;
  }
  .engel::before {
    content: ""; position: absolute; left: 18px; top: 50%; width: 20px; height: 20px; margin-top: -10px;
    background: rgba(255, 255, 255, .35); clip-path: polygon(30% 0, 100% 0, 70% 100%, 0 100%); transition: background-color .18s, transform .25s var(--ease-out);
  }
  .engel:hover { background: #b8001f; }
  .engel[aria-pressed="true"] { background: #fff; color: var(--ink); }
  .engel[aria-pressed="true"]::before { background: var(--accent); transform: scaleX(1.25); }
  .kim__out { margin-top: 6px; background: var(--ink); padding: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .kim__out p { margin: 0; max-width: 46ch; font-weight: 600; }

  /* ---------- questions ---------- */
  /* a black chapter, its top edge cut on the logo's slant so the session above clearly ends */
  .faq {
    display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 0 calc(var(--margin) * 2); align-items: start;
    padding: calc(120px + 8vh) var(--margin) calc(160px + 8vh); margin-top: -8vh;
    background: var(--ink); color: #fff; clip-path: polygon(0 0, 100% 8vh, 100% 100%, 0 100%);
  }
  .faq__title { grid-column: 1 / -1; margin-bottom: 56px; }
  .faq__list { grid-column: 1; grid-row: 2; display: grid; gap: 6px; }
  .faq__side { grid-column: 2; grid-row: 2; position: sticky; top: 24px; }
  .faq__img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; object-position: 40% 50%; clip-path: polygon(0 0, 100% 0, 86% 100%, 0 100%); margin-bottom: 24px; }
  .faq__side p { font-weight: 600; }
  .faq__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .btn--quiet { background: #1f2226; color: #fff; }
  .btn--quiet:hover { background: #30343a; }
  .q { background: #1a1c20; }
  .q summary {
    display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 24px; cursor: pointer; list-style: none;
    font-size: clamp(1.125rem, 1rem + .45vw, 1.4375rem); font-weight: 700; line-height: 1.25;
  }
  .q summary::-webkit-details-marker { display: none; }
  .q summary:hover { color: var(--accent); }
  .q[open] { background: #fff; color: var(--ink); }
  .q[open] summary:hover { color: var(--accent-deep); }
  .q summary:active { transform: scale(.985); }
  .q summary { transition: transform .15s var(--ease-out), color .2s; }
  .q summary i { flex: none; width: 22px; height: 22px; background: #fff; clip-path: polygon(40% 0, 100% 0, 60% 100%, 0 100%); transition: transform .3s var(--ease-out), background-color .2s; }
  .q[open] summary i { background: var(--accent); transform: rotate(90deg); }
  .q p { margin: 0; padding: 0 24px 24px; max-width: 60ch; }

  /* ---------- entrances (only when script runs) ---------- */
  :global(.js) .e-hero__title .line > span { transform: translateY(105%); }
  :global(.js) .pulse polygon { transform: scaleY(0); }
  :global(.js) [data-rise] { opacity: 0; transform: translateY(22px); }
  :global(.is-in) .e-hero__title .line > span, :global(.is-in) [data-rise], :global(.is-in) .pulse polygon { opacity: 1; transform: none; transition: transform .8s var(--ease-out), opacity .8s; }

  @media (max-width: 860px) {
    .e-hero { grid-template-columns: 1fr; min-height: 0; align-items: start; padding: 6vh var(--margin) 150px; }
    .e-hero__title { font-size: 25vw; }
    .pulse { height: 96px; }
    .sig, .hist, .ses, .kim, .faq { grid-template-columns: 1fr; padding: 96px var(--margin); }
    .sig__img { grid-row: auto; order: 2; }
    .sig__text, .sig__fig { grid-column: 1; }
    .sig__fig { order: 3; }
    .sig__img img { max-height: 70svh; object-position: center top; }
    .faq { padding: calc(96px + 8vh) var(--margin) calc(96px + 8vh); }
    .faq__title { margin-bottom: 36px; }
    .faq__list, .faq__side { grid-column: 1; grid-row: auto; }
    .faq__side { position: static; margin-top: 48px; }
    .faq__img { aspect-ratio: 4 / 3; }
    .rail { gap: 14px; }
    .rail::before { left: calc(33.33% - 14px); }
    .rail::after { left: calc(66.66% - 6px); }
    .rail::before, .rail::after { width: 14px; height: 22px; margin-top: -11px; }
    .hist__img { margin: 0 calc(-1 * var(--margin)); }
    .hist__img figcaption { padding: 0 var(--margin); }
    .ses__media { position: relative; top: 0; margin: 0 calc(-1 * var(--margin)); aspect-ratio: 4 / 5; clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%); }
    .ses__steps li { grid-template-columns: 52px 1fr; column-gap: 16px; }
    .ses__bar { width: 30px; }
    .kim { padding: calc(96px + 6vh) var(--margin) 96px; }
    .kim__list { grid-template-columns: 1fr; }
    .kim__out { padding: 22px; }
    .q summary { padding: 18px; }
    .q p { padding: 0 18px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .e-hero__title .line > span, :global(.js) [data-rise], :global(.js) .pulse polygon { opacity: 1; transform: none; }
  }
</style>

<script>
import { animate, stagger, inView, press } from 'motion';
window.__motion = true;
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const tap = { type: 'spring', stiffness: 400, damping: 20 } as const;
press('.engel', el => {
  animate(el, { scale: 0.97 }, tap);
  return () => animate(el, { scale: 1 }, tap);
});
if (reduce) { document.body.classList.add('is-in'); }
else {
  const ease = [0.22, 1, 0.36, 1] as const;
  // one orchestrated entrance: the headline rises, then the impulse train switches on from left to right
  animate('.e-hero__title .line > span', { y: ['105%', '0%'] }, { type: 'spring', stiffness: 140, damping: 20, delay: stagger(0.09) });
  animate('.pulse polygon', { scaleY: [0, 1] }, { duration: 0.5, ease, delay: stagger(0.012, { startDelay: 0.35 }) });
  document.querySelectorAll('.e-hero, .sig, .hist, .ses, .kim, .faq').forEach(block => {
    inView(block, () => {
      animate(block.querySelectorAll('[data-rise]'), { opacity: [0, 1], y: [22, 0] }, { duration: 0.7, ease, delay: stagger(0.08, { startDelay: 0.15 }) });
    }, { amount: 0.1 });
  });
}
</script>
<script is:inline define:vars={{ waSaglik, waRandevu }}>
setTimeout(() => { if (!window.__motion) document.body.classList.add('is-in'); }, 1500);

// the session clip loads only when it comes near; phones get the portrait cut
(() => {
  const v = document.querySelector('.ses__video');
  const narrow = matchMedia('(max-width: 860px)').matches;
  if (narrow) v.poster = v.dataset.posterNarrow;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saver = navigator.connection && navigator.connection.saveData;
  if (reduce || saver || !('IntersectionObserver' in window)) return;
  const io = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) { if (v.src) v.pause(); return; }
    if (!v.src) v.src = narrow ? v.dataset.srcNarrow : v.dataset.src;
    v.play().catch(() => {});
  }, { rootMargin: '300px 0px' });
  io.observe(v);
})();

// "who should not": tick what applies, read what to do next
(() => {
  const out = document.getElementById('kim-sonuc');
  const wa = document.getElementById('kim-wa');
  const label = wa.querySelector('span');
  const btns = document.querySelectorAll('.engel');
  btns.forEach(b => b.addEventListener('click', () => {
    b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
    const n = document.querySelectorAll('.engel[aria-pressed="true"]').length;
    if (n) {
      out.textContent = n === 1
        ? 'Bu durumda EMS\'e doktorunun onayı olmadan başlama. Doktoruna danıştıktan sonra bize yaz, birlikte planlayalım.'
        : 'Bu durumlarda EMS\'e doktorunun onayı olmadan başlama. Doktoruna danıştıktan sonra bize yaz, birlikte planlayalım.';
      wa.href = waSaglik; label.textContent = 'WhatsApp\'tan sor';
    } else {
      out.textContent = 'Listedekilerden hiçbiri sende yok. Başka bir sağlık sorunun varsa ilk görüşmede bize söyle.';
      wa.href = waRandevu; label.textContent = 'Randevu al';
    }
  }));
})();
</script>
