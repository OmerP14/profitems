  .lb::backdrop { background: rgba(0, 0, 0, .6); }
  .lb__img { display: block; max-width: min(100%, 1600px); max-height: calc(100svh - 120px); width: auto; height: auto; object-fit: contain; background: #fff; }
  .lb__cap { margin: 0; max-width: 70ch; text-align: center; font-size: .9375rem; color: rgba(255, 255, 255, .82); }
  .lb form { position: absolute; top: 10px; right: 10px; margin: 0; }
  .lb__kapat { width: 48px; height: 48px; border: 0; border-radius: 0; background: rgba(255, 255, 255, .12); color: #fff; font-size: 1.25rem; cursor: pointer; }
  .lb__kapat:hover { background: var(--accent); }

  /* ---------- facility certificate, as a seal ---------- */
  .kt {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px calc(var(--margin) * 3); align-items: center;
    padding: 150px var(--margin) 100px; overflow: hidden;
  }
  .kt__rozet { position: relative; isolation: isolate; width: min(100%, 480px); aspect-ratio: 1; justify-self: center; display: grid; place-items: center; }
  .kt__rozet::before {
    content: ""; position: absolute; z-index: -1; inset: -8% 20%;
    background: var(--accent); clip-path: polygon(42% 0, 100% 0, 58% 100%, 0 100%);
  }
  .kt__halka { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; animation: kt-don 30s linear infinite; }
  .kt__halka text { fill: var(--ink); font-size: 19px; font-weight: 800; font-style: italic; letter-spacing: .1em; }
  .kt__a {
    position: relative; display: block; width: 56%; -webkit-tap-highlight-color: transparent;
    filter: drop-shadow(0 26px 30px rgba(0, 0, 0, .35));
    animation: kt-sal 6s ease-in-out infinite;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1);
  }
  /* kept upright and unscaled at all times: a tilted or scaled badge is redrawn soft, and its small print blurs */
  .kt__a:hover { transform: translateY(-8px); }
  .kt__a:focus-visible { outline: 3px solid var(--ink); outline-offset: 6px; }
  .kt__a img { display: block; width: 100%; height: auto; image-rendering: high-quality; }
  @keyframes kt-don { to { rotate: 360deg; } }
  @keyframes kt-sal { 50% { translate: 0 -12px; } }

  .kt__ust { margin: 0 0 10px; font-size: .875rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .kt h2 { font-size: clamp(3.5rem, 8vw, 8rem); margin-bottom: 26px; }
  .kt p { max-width: 44ch; }
  .kt__eylem { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 26px; }
  .kt__dogrula { display: inline-block; padding: 12px 0; font-weight: 700; color: inherit; text-underline-offset: 4px; }
  .kt__dogrula:hover { color: var(--accent); }
  .kt__adim { list-style: none; counter-reset: adim; margin: 6px 0 36px; padding: 0; display: grid; gap: 14px; }
  .kt__adim li {
    counter-increment: adim; display: grid; grid-template-columns: 52px minmax(0, 1fr); align-items: baseline;
    font-size: clamp(1.0625rem, 1rem + .3vw, 1.25rem); font-weight: 600;
  }
  .kt__adim li::before {
    content: "0" counter(adim); color: var(--accent); font-size: 1.875rem; line-height: 1;
    font-style: italic; font-weight: 800; font-variation-settings: "wdth" 62;
  }

  /* ---------- closing band ---------- */
  .k-cta { background: var(--accent); color: #fff; padding: calc(120px + 8vh) var(--margin) 120px; clip-path: polygon(0 8vh, 100% 0, 100% 100%, 0 100%); }
  .k-cta h2 { font-size: clamp(3.5rem, 8vw, 8.5rem); margin-bottom: 24px; }
  .k-cta p { max-width: 46ch; margin-bottom: 32px; }
  .k-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn--ghost { background: rgba(0, 0, 0, .18); color: #fff; }
  .btn--ghost:hover { background: rgba(0, 0, 0, .32); }

  /* ---------- entrances (only when script runs) ---------- */
  :global(.js) .k-hero__title .line > span { transform: translateY(105%); }
  :global(.js) [data-rise] { opacity: 0; transform: translateY(22px); }
  :global(.is-in) .k-hero__title .line > span, :global(.is-in) [data-rise] { opacity: 1; transform: none; transition: transform .8s var(--ease-out), opacity .8s; }

  @media (max-width: 860px) {
    .k-hero { grid-template-columns: 1fr; padding: 6vh var(--margin) 48px; }
    .k-hero__title { font-size: 26vw; }
    /* on a phone the same slanted strips stay side by side: tap or swipe to choose,
       the chosen one widens into colour and its details appear underneath */
    .k-ekip { --slant: 9vw; --seam: 6px; }
    .trio { height: min(60svh, 520px); min-height: 360px; touch-action: pan-y; }
    .trio__p.is-on { flex-grow: 2.4; }
    .trio__p:active .trio__img { transform: scale(1.07); transition-duration: .2s; }
    .trio__ad { font-size: 0; left: 0; bottom: 0; }
    .trio__sec { padding: 0; background: none; }
    .trio__p:has(.trio__sec:focus-visible) { outline-offset: -5px; }
    .trio__p::after { content: ""; position: absolute; inset: 55% 0 0; z-index: -1; background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, .7)); }
    .trio__kisa {
      display: block; position: absolute; left: 12px; bottom: 16px;
      writing-mode: vertical-rl; transform: rotate(180deg);
      font-style: italic; font-weight: 800; font-variation-settings: "wdth" 62; text-transform: uppercase;
      font-size: 1.625rem; line-height: 1; letter-spacing: -0.01em; color: #fff;
      transition: opacity .3s;
    }
    .trio__p.is-on .trio__kisa, .trio__p.is-on::after { opacity: 0; }

    .k-detay { padding-top: 28px; }
    .k-detay__item { grid-template-columns: 1fr; gap: 0; }
    .k-detay__item:not(.is-on) { display: none; }
    .k-detay__ad { font-size: 15vw; }
    .k-detay__unvan { margin-bottom: 18px; }
    .k-detay .btn { min-height: 54px; padding: 0 24px; }

    .kb { margin-top: 96px; padding: calc(72px + 8vw) var(--margin) 96px; clip-path: polygon(0 8vw, 100% 0, 100% 100%, 0 100%); }
    .pano__kartlar::before { top: -6%; bottom: -8%; left: 14%; width: 72%; }
    .kb__head { grid-template-columns: 1fr; }
    .kb h2 { font-size: 19vw; }
    /* the coach chips scroll sideways in one row */
    :global(.js) .kb__sekme {
      flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin: 36px calc(var(--margin) * -1) 44px; padding: 4px var(--margin);
    }
    .kb__tab { flex: none; scroll-snap-align: start; grid-template-columns: 44px auto; padding-right: 20px; }
    .kb__av { width: 44px; height: 44px; }
    .kb__tab-ad { font-size: 1.125rem; }
    .pano { grid-template-columns: 1fr; gap: 44px; }
    .polaroid { --r: -3deg; width: 64%; justify-self: center; }
    .pano__kartlar { gap: 40px; padding-bottom: 40px; }
    .kart, .pano__kartlar--2 .kart { --r: 1.5deg; grid-area: auto; width: 100%; margin-top: 0; justify-self: stretch; }
    .pano__kartlar--2 .kart:nth-of-type(1) { --r: -1.5deg; }
    .kb__zoom { opacity: 1; }
    .kart__kod { margin-left: 0; }
    .damga, .pano__kartlar--2 .damga { font-size: 1.375rem; left: auto; top: auto; right: 6px; bottom: 0; }
    .lb { padding: 64px 8px 16px; }

    .kt { grid-template-columns: 1fr; gap: 48px; padding: 96px var(--margin) 80px; }
    .kt__rozet { width: min(82vw, 400px); }
    .kt h2 { font-size: 17vw; }
    .k-cta { padding: calc(96px + 6vh) var(--margin) 96px; }
  }
</style>

<script>
import { animate, stagger, inView } from 'motion';
window.__motion = true;
{
  const ease = [0.22, 1, 0.36, 1];
  // one orchestrated entrance: the word rises, then the panels slide up in turn
  animate('.k-hero__title .line > span', { y: ['105%', '0%'] }, { type: 'spring', stiffness: 140, damping: 20 });
  animate('.k-hero [data-rise]', { opacity: [0, 1], y: [22, 0] }, { duration: 0.7, ease, delay: 0.25 });
  animate('.trio__p', { opacity: [0, 1], y: [60, 0] }, { type: 'spring', stiffness: 120, damping: 20, delay: stagger(0.1, { startDelay: 0.3 }) });
  document.querySelectorAll('.kb__head, .kt, .k-cta').forEach(block => {
    inView(block, () => {
      animate(block.querySelectorAll('[data-rise]'), { opacity: [0, 1], y: [22, 0] }, { duration: 0.7, ease, delay: stagger(0.08, { startDelay: 0.1 }) });
    }, { amount: 0.2 });
  });
}
</script>
<script is:inline>
setTimeout(() => { if (!window.__motion) document.body.classList.add('is-in'); }, 1500);

// choosing a coach: pointing at a panel, tabbing to it or tapping it widens it and shows their details underneath
(() => {
  const panels = [...document.querySelectorAll('.trio__p')];
  const details = [...document.querySelectorAll('.k-detay__item')];
  const choose = p => {
    if (p.classList.contains('is-on')) return;
    panels.forEach((x, i) => {
      const on = x === p;
      x.classList.toggle('is-on', on);
      x.querySelector('.trio__sec').setAttribute('aria-expanded', String(on));
      details[i]?.classList.toggle('is-on', on);
    });
  };
  // a sideways swipe across the strips moves to the next or previous coach
  const trio = document.querySelector('.trio');
  let x0 = null, y0 = null;
  trio.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  trio.addEventListener('touchend', e => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    x0 = null;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
    const cur = panels.findIndex(x => x.classList.contains('is-on'));
    const next = Math.max(0, Math.min(panels.length - 1, cur + (dx < 0 ? 1 : -1)));
    choose(panels[next]);
  }, { passive: true });
  panels.forEach(p => {
    p.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') choose(p); });
    p.addEventListener('click', () => choose(p));
    p.addEventListener('focusin', () => choose(p));
  });
})();

// the certificate wall: one coach's board at a time, chosen with the chips (arrow keys move between them);
// "Belgelerini gör" links and #belge-<id> addresses open that coach's board
(() => {
  const tabs = [...document.querySelectorAll('.kb__tab')];
  const wall = document.getElementById('belgelerimiz');
  if (!tabs.length || !wall) return;
  // a board's pictures start loading as soon as its chip is pointed at or chosen, not when the lazy loader gets round to it
  const warm = id => document.querySelectorAll(`#belge-${id} img[loading="lazy"]`).forEach(i => { i.loading = 'eager'; });
  tabs.forEach(t => t.addEventListener('pointerenter', () => warm(t.dataset.id), { once: true }));
  const select = (id, focus) => {
    warm(id);
    tabs.forEach(t => {
      const on = t.dataset.id === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    wall.querySelectorAll('.pano').forEach(p => p.classList.toggle('is-on', p.id === `belge-${id}`));
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.id));
    t.addEventListener('keydown', e => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      select(tabs[(i + d + tabs.length) % tabs.length].dataset.id, true);
    });
  });
  const fromHash = h => {
    const m = /^#belge-(.+)$/.exec(h || '');
    if (!m || !tabs.some(t => t.dataset.id === m[1])) return false;
    select(m[1]);
    return true;
  };
  document.querySelectorAll('a[href^="#belge-"]').forEach(a => a.addEventListener('click', e => {
    const h = a.getAttribute('href');
    if (!fromHash(h)) return;
    e.preventDefault();
    history.replaceState(null, '', h);
    document.querySelector(h).scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  if (fromHash(location.hash)) document.querySelector(location.hash).scrollIntoView({ block: 'start' });
})();

// the viewer: a certificate or photo opens at full resolution; without script the link opens the image itself
(() => {
  const lb = document.getElementById('lb');
  if (!lb || typeof lb.showModal !== 'function') return;
  const img = lb.querySelector('.lb__img'), cap = lb.querySelector('.lb__cap');
  document.querySelectorAll('[data-lb]').forEach(a => a.addEventListener('click', e => {
    e.preventDefault();
    img.src = a.href; img.width = +a.dataset.w; img.height = +a.dataset.h;
    img.alt = a.querySelector('img')?.alt || '';
    cap.textContent = a.dataset.cap || '';
    lb.showModal();
  }));
  // a tap outside the picture closes it
  lb.addEventListener('click', e => { if (e.target === lb) lb.close(); });
  lb.addEventListener('close', () => { img.removeAttribute('src'); });
})();
</script>
