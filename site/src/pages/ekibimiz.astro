  @keyframes kart-gel { from { opacity: 0; transform: translateY(80px) rotate(calc(var(--r) - 12deg)) scale(.94); } }
  @keyframes damga-bas { from { opacity: 0; transform: rotate(-12deg) scale(2.4); } }

  /* ---------- the viewer ---------- */
  .lb { width: 100vw; height: 100svh; max-width: none; max-height: none; margin: 0; padding: 56px 16px 20px; border: 0; background: rgba(10, 10, 10, .94); color: #fff; }
